# Keep text files LF on every platform so Git checkouts match .editorconfig and Biome.
* text=auto eol=lf

# Patch files must keep LF line endings. CRLF checkout makes git apply
# treat blank context lines inside hunks as corrupt patches on Windows.
# A single space is a required empty context line, not trailing source whitespace.
*.patch text eol=lf -whitespace
