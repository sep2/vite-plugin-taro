---
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import HmrVideoFrame from './hmr-video-frame.astro'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import HomeSectionHeading from './home-section-heading.astro'
---

<section class="home-section demo-section" aria-labelledby="demo-title">
    <HmrVideoFrame variant="showcase" />

    <div class="demo-copy">
        <HomeSectionHeading
            id="demo-title"
            kicker="不是重新加载，是热更新"
            title="状态原地保留"
            description="修改任意深度的 React 组件，VPT 会把最小更新送进微信开发者工具。当前页面、表单输入和组件状态继续留在原位。"
            align="start"
        />
        <ul>
            <li><span>✓</span> 深层 React 组件即时更新</li>
            <li><span>✓</span> App、页面与输入状态保留</li>
            <li><span>✓</span> Tailwind 样式同步刷新</li>
        </ul>
        <a href="/guides/hot-module-replacement/">了解热更新机制 <span aria-hidden="true">→</span></a>
    </div>
</section>


<style>
    .demo-section {
        display: grid;
        grid-template-columns: minmax(25rem, 1.2fr) minmax(0, 0.8fr);
        align-items: center;
        gap: clamp(2rem, 6vw, 5rem);
    }

    .demo-copy ul {
        display: grid;
        gap: 0.65rem;
        margin: 0 0 1.6rem;
        padding: 0;
        color: var(--vpt-text);
        font-size: var(--home-font-size-body);
        line-height: 1.7;
        list-style: none;
    }

    .demo-copy li span {
        display: inline-grid;
        width: 1.35rem;
        height: 1.35rem;
        margin-right: 0.45rem;
        border-radius: 50%;
        background: var(--vpt-chip-background);
        color: var(--vpt-accent);
        font-size: var(--home-font-size-small);
        place-items: center;
    }

    .demo-copy > a {
        color: var(--vpt-accent-strong);
        font-size: var(--home-font-size-body);
        font-weight: 700;
        text-decoration: none;
    }

    .demo-copy > a:hover {
        text-decoration: underline;
    }

    @media (max-width: 64rem) {
        .demo-section {
            grid-template-columns: 1fr;
        }

        .demo-copy {
            max-width: 42rem;
        }
    }
</style>
