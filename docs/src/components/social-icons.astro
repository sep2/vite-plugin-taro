---
import config from 'virtual:starlight/user-config'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import { Icon } from '@astrojs/starlight/components'

// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const links = config.social ?? []
---

{
    links.map(({ label, href, icon }) => (
        <a href={href} target="_blank" rel="me noopener noreferrer" class="sl-flex">
            <span class="sr-only">{label}</span>
            <Icon name={icon} />
        </a>
    ))
}

<style>
    @layer starlight.core {
        a {
            margin: -0.5em;
            padding: 0.5em;
            color: var(--sl-color-text-accent);
        }

        a:hover {
            color: var(--sl-color-white);
        }
    }
</style>
