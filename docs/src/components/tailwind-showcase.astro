        justify-content: flex-end;
        gap: 1rem;
        min-height: 2.65rem;
        padding: 0.75rem 1rem;
        border-top: 1px solid rgba(190, 224, 197, 0.12);
        background: #142c1f;
        color: #91a697;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: var(--home-font-size-small);
    }

    .code-status span {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .status-ready {
        position: relative;
        width: 0.45rem;
        height: 0.45rem;
        margin: 0;
        border-radius: 50%;
        background: #72d58b;
        box-shadow: 0 0 0 0.2rem rgba(114, 213, 139, 0.12);
    }

    .status-ready::after,
    .preview-label i::after {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: #ff9b7f;
        box-shadow: 0 0 0 0.42rem rgba(255, 155, 127, 0.08);
