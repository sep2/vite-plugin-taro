    }

    .wifi-icon {
        width: 0.8rem;
        fill: currentColor;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-width: 1.5;
    }

    .wifi-icon path {
        fill: none;
    }

    .battery-icon {
        width: 1rem;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-width: 1.5;
    }

    .battery-icon .battery-level {
        fill: currentColor;
        stroke: none;
    }

    .app-header {
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0.85rem 1.15rem 0.75rem;
