        .phone-stage {
            height: auto;
        }

        .phone-shell {
            height: var(--tailwind-demo-height);
        }

        .preview-chips {
            position: static;
            flex-wrap: wrap;
            width: 100%;
            margin-top: 1rem;
            transform: none;
        }
    }

