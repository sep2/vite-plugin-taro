    .style-hmr-toast {
        display: flex;
        position: absolute;
        z-index: 4;
        top: 0.72rem;
        right: 0.72rem;
        align-items: center;
        gap: 0.22rem;
        padding: 0.25rem 0.42rem;
        border: 1px solid rgba(139, 58, 45, 0.14);
        border-radius: 999px;
        background: rgba(255, 253, 245, 0.94);
        box-shadow: 0 0.35rem 0.9rem rgba(125, 47, 36, 0.16);
        color: #a64637;
        font-size: var(--home-font-size-small);
        line-height: 1;
        opacity: 0;
        transform: translateY(-0.3rem) scale(0.96);
        white-space: nowrap;
    }

    .style-hmr-toast i {
        display: grid;
        width: 0.8rem;
        height: 0.8rem;
        margin: 0;
        border-radius: 50%;
        background: #e96f55;
        color: #fffdf5;
        font-size: var(--home-font-size-small);
        font-style: normal;
        place-items: center;
    }

    .style-hmr-toast b {
        font-weight: 750;
    }

    .style-hmr-toast small {
        color: #bd6959;
        font-size: var(--home-font-size-small);
    }

    .metric-label {
        display: block;
        color: #bce5b1;
        font-size: var(--home-font-size-small);
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .steps-card > strong {
        display: block;
        margin-top: 0.3rem;
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 2.35rem;
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1;
    }

    .steps-card > small {
        color: #a9b9ad;
        font-size: var(--home-font-size-small);
    }

    .progress-track {
        height: 0.45rem;
        margin-top: 1.15rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        overflow: hidden;
    }

    .progress-track span {
        display: block;
        width: 79%;
        height: 100%;
        border-radius: inherit;
        background: #c9eb78;
    }

    .steps-card > p {
        display: flex;
        justify-content: space-between;
        margin: 0.5rem 0 0;
        color: #a9b9ad;
        font-size: var(--home-font-size-small);
    }

    .steps-card > p b {
        color: #c9eb78;
    }

    .style-copy {
        --style-copy-updated-color: #fff0e8;
        display: inline-grid;
    }

    .metric-label.style-copy {
        --style-copy-updated-color: #fff2c2;
        display: grid;
    }

    .style-copy > span {
        grid-area: 1 / 1;
    }

    .style-copy > .style-copy-updated {
        color: var(--style-copy-updated-color);
        opacity: 0;
    }

    .metric-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.65rem;
        margin-top: 0.7rem;
    }

    .metric-grid article {
        display: grid;
        padding: 0.85rem;
        border: 1px solid var(--phone-surface-border);
        border-radius: 1.15rem;
        background: var(--phone-surface-background);
    }

    .metric-icon {
        display: grid;
        width: 1.45rem;
        height: 1.45rem;
        margin-bottom: 0.65rem;
        border-radius: 0.5rem;
        color: #fffef8;
        font-size: var(--home-font-size-small);
        place-items: center;
    }

    .metric-icon.coral {
        background: #ed987e;
    }

    .metric-icon.green {
        background: #58a76c;
    }

    .metric-grid small {
        color: var(--phone-subtle);
        font-size: var(--home-font-size-small);
    }

    .metric-grid strong {
        margin-top: 0.15rem;
        color: var(--phone-heading);
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 1.05rem;
    }

    .metric-grid strong i {
        color: var(--phone-unit);
        font-family: inherit;
        font-size: var(--home-font-size-small);
        font-style: normal;
        font-weight: 500;
    }

    .activity-card {
        margin-top: 0.7rem;
        padding: 0.9rem;
        border: 1px solid var(--phone-surface-border);
        border-radius: 1.15rem;
        background: var(--phone-surface-background);
    }

    .activity-card header {
        display: flex;
        justify-content: space-between;
        font-size: var(--home-font-size-small);
    }

    .activity-card header span {
        color: var(--phone-link);
        font-size: var(--home-font-size-small);
    }

    .activity-bars {
        display: flex;
        align-items: end;
        justify-content: space-between;
        height: 3.6rem;
        margin-top: 0.65rem;
    }

    .activity-bars i {
        width: 0.65rem;
        height: var(--bar-height);
        margin: 0;
        border-radius: 999px 999px 0.35rem 0.35rem;
        background: var(--phone-chart-bar);
    }

    .activity-bars .today {
        background: linear-gradient(#c9eb78, #4aa467);
    }

    .activity-days {
        display: flex;
        justify-content: space-between;
        margin-top: 0.3rem;
        color: var(--phone-subtle);
        font-size: var(--home-font-size-small);
    }

    .preview-chips {
        display: flex;
        position: absolute;
        z-index: 2;
        bottom: -3.25rem;
        left: 50%;
        justify-content: center;
        gap: 0.4rem;
        width: max-content;
        transform: translateX(-50%);
    }

    .preview-chips span {
        padding: 0.3rem 0.55rem;
        border: 1px solid var(--vpt-border);
        border-radius: 999px;
        background: var(--vpt-chip-background);
        color: var(--vpt-chip-text);
        font-size: var(--home-font-size-small);
    }

    .tailwind-guide-link {
        display: block;
        width: fit-content;
        margin: var(--home-section-heading-gap) auto 0;
        color: var(--vpt-accent-strong);
        font-weight: 700;
        text-decoration: none;
    }

    .tailwind-guide-link:hover {
        text-decoration: underline;
    }

    vpt-tailwind-showcase.is-live .hmr-edit-line::before {
        animation: hmr-edit-highlight var(--style-hmr-cycle) linear infinite;
    }

    vpt-tailwind-showcase.is-live .code-value-before {
        animation: hmr-code-before var(--style-hmr-cycle) linear infinite;
    }

    vpt-tailwind-showcase.is-live .code-value-after {
        animation: hmr-code-after var(--style-hmr-cycle) linear infinite;
    }

    vpt-tailwind-showcase.is-live .code-caret {
        animation: hmr-code-caret var(--style-hmr-cycle) linear infinite;
    }

    vpt-tailwind-showcase.is-live .hmr-status-watching {
        animation: hmr-status-watching var(--style-hmr-cycle) linear infinite;
    }

    vpt-tailwind-showcase.is-live .hmr-status-updated {
        animation: hmr-status-updated var(--style-hmr-cycle) linear infinite;
    }

    vpt-tailwind-showcase.is-live .hmr-status > .status-ready,
    vpt-tailwind-showcase.is-live .preview-label i {
        animation: hmr-status-pulse var(--style-hmr-cycle) linear infinite;
    }

    vpt-tailwind-showcase.is-live .hmr-status > .status-ready::after,
    vpt-tailwind-showcase.is-live .preview-label i::after {
        animation: hmr-status-color var(--style-hmr-cycle) linear infinite;
    }

    vpt-tailwind-showcase.is-live .steps-card {
        animation: hmr-phone-card var(--style-hmr-cycle) ease-in-out infinite;
    }

    vpt-tailwind-showcase.is-live .steps-card::before,
    vpt-tailwind-showcase.is-live .style-copy-updated {
        animation: hmr-phone-skin var(--style-hmr-cycle) ease-in-out infinite;
    }

    vpt-tailwind-showcase.is-live .style-hmr-toast {
        animation: hmr-phone-toast var(--style-hmr-cycle) ease-in-out infinite;
    }

    vpt-tailwind-showcase.is-live .style-update-flash {
        animation: hmr-phone-flash var(--style-hmr-cycle) ease-out infinite;
    }

    /* Every changing visual is prepainted on a temporary layer, so the timeline only composites opacity and transforms. */
    vpt-tailwind-showcase.is-live .hmr-edit-line::before,
    vpt-tailwind-showcase.is-live .code-value-before,
    vpt-tailwind-showcase.is-live .code-value-after,
    vpt-tailwind-showcase.is-live .code-caret,
    vpt-tailwind-showcase.is-live .hmr-status-watching,
    vpt-tailwind-showcase.is-live .hmr-status-updated,
    vpt-tailwind-showcase.is-live .hmr-status > .status-ready,
    vpt-tailwind-showcase.is-live .hmr-status > .status-ready::after,
    vpt-tailwind-showcase.is-live .preview-label i,
    vpt-tailwind-showcase.is-live .preview-label i::after,
    vpt-tailwind-showcase.is-live .steps-card,
    vpt-tailwind-showcase.is-live .steps-card::before,
    vpt-tailwind-showcase.is-live .style-copy-updated,
    vpt-tailwind-showcase.is-live .style-hmr-toast,
    vpt-tailwind-showcase.is-live .style-update-flash {
        will-change: opacity, transform;
    }

    @keyframes hmr-edit-highlight {
        0%,
        18%,
        81%,
        100% {
            opacity: 0;
        }

        25%,
        74% {
            opacity: 1;
        }
    }

    @keyframes hmr-code-before {
        0%,
        18%,
        81%,
        100% {
            opacity: 1;
            transform: translateY(0);
        }

        25%,
        74% {
            opacity: 0;
            transform: translateY(-0.18rem);
        }
    }

    @keyframes hmr-code-after {
        0%,
        18%,
        81%,
        100% {
            opacity: 0;
            transform: translateY(0.18rem);
        }

        25%,
        74% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes hmr-code-caret {
        0%,
        16%,
        20%,
        24%,
        69%,
        73%,
        77%,
        100% {
            opacity: 0;
        }

        18%,
        22%,
        71%,
        75% {
            opacity: 1;
        }
    }

    @keyframes hmr-status-watching {
        0%,
        28%,
        80%,
        100% {
            opacity: 1;
            transform: translateY(0);
        }

        34%,
        74% {
            opacity: 0;
            transform: translateY(-0.2rem);
        }
    }

    @keyframes hmr-status-updated {
        0%,
        28%,
        80%,
        100% {
            opacity: 0;
            transform: translateY(0.2rem);
        }

        34%,
        74% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes hmr-status-pulse {
        0%,
        28%,
        38%,
        77%,
        87%,
        100% {
            transform: scale(1);
        }

        31%,
        80% {
            transform: scale(1.18);
        }
    }

    @keyframes hmr-status-color {
        0%,
        28%,
        38%,
        77%,
        87%,
        100% {
            opacity: 0;
        }

        31%,
        80% {
            opacity: 1;
        }
    }

    @keyframes hmr-phone-card {
        0%,
        29%,
        34%,
        79%,
        84%,
        100% {
            transform: scale(1);
        }

        31%,
        81% {
            transform: scale(0.985);
        }
    }

    @keyframes hmr-phone-skin {
        0%,
        29%,
        84%,
        100% {
            opacity: 0;
        }

        34%,
        79% {
            opacity: 1;
        }
    }

    @keyframes hmr-phone-toast {
        0%,
        28%,
        45%,
        77%,
        94%,
        100% {
            opacity: 0;
            transform: translateY(-0.3rem) scale(0.96);
        }

        31%,
        40%,
        80%,
        89% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @keyframes hmr-phone-flash {
        0%,
        29%,
        39%,
        78%,
        88%,
        100% {
            opacity: 0;
            transform: scale(0.97);
        }

        31%,
        80% {
            opacity: 0.78;
            transform: scale(1);
        }

        38%,
        87% {
            opacity: 0;
            transform: scale(1.03);
        }
    }

    @supports (animation-timeline: view()) and (view-timeline-name: --tailwind-phone-scroll) {
        .phone-shell {
            transform: perspective(90rem) rotateX(6deg) rotateY(-18deg);
            view-timeline-axis: block;
            view-timeline-name: --tailwind-phone-scroll;
            animation: tailwind-phone-scroll linear both;
            /* Keep the named timeline separate from the optimizer's animation shorthand. */
            animation-timeline: --tailwind-phone-scroll !important;
        }
    }

    @keyframes tailwind-phone-scroll {
        0% {
            transform: perspective(90rem) rotateX(6deg) rotateY(-18deg);
        }

        44%,
        56% {
            transform: perspective(90rem) rotateX(0) rotateY(0);
        }

        100% {
            transform: perspective(90rem) rotateX(-6deg) rotateY(18deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        vpt-tailwind-showcase.is-live .hmr-edit-line::before,
        vpt-tailwind-showcase.is-live .code-value-before,
        vpt-tailwind-showcase.is-live .code-value-after,
        vpt-tailwind-showcase.is-live .code-caret,
        vpt-tailwind-showcase.is-live .hmr-status-watching,
        vpt-tailwind-showcase.is-live .hmr-status-updated,
        vpt-tailwind-showcase.is-live .hmr-status > .status-ready,
        vpt-tailwind-showcase.is-live .hmr-status > .status-ready::after,
        vpt-tailwind-showcase.is-live .preview-label i,
        vpt-tailwind-showcase.is-live .preview-label i::after,
        vpt-tailwind-showcase.is-live .steps-card,
        vpt-tailwind-showcase.is-live .steps-card::before,
        vpt-tailwind-showcase.is-live .style-copy-updated,
        vpt-tailwind-showcase.is-live .style-hmr-toast,
        vpt-tailwind-showcase.is-live .style-update-flash {
            animation: none;
        }

        .phone-shell {
            transform: none;
            animation: none;
            animation-timeline: auto !important;
        }
    }

    @media (max-width: 52rem) {
        .tailwind-stage {
            grid-template-columns: 1fr;
            max-width: 42rem;
            margin-inline: auto;
        }

        .phone-preview {
            min-height: 0;
            padding-top: 2.75rem;
