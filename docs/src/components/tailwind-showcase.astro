    .steps-card::before {
        position: absolute;
        z-index: 0;
        inset: 0;
        border-radius: inherit;
        background:
            radial-gradient(circle at 88% 10%, rgba(255, 237, 190, 0.16), transparent 34%),
            #e96f55;
        content: '';
        opacity: 0;
    }

    .steps-card::after {
        position: absolute;
        z-index: 1;
        top: -2.5rem;
        right: -1.4rem;
        width: 7rem;
        height: 7rem;
        border: 1px solid rgba(205, 239, 175, 0.2);
        border-radius: 50%;
        content: '';
    }

    .steps-card > * {
        position: relative;
