        --phone-shell-background: #17191d;
        --phone-shell-ring: #39413b;
        --phone-screen-background: #24272c;
        --phone-surface-background: #2b2f34;
        --phone-surface-border: #43484f;
        --phone-text: #dfe0e3;
        --phone-heading: #f5f5f2;
        --phone-muted: #a5a9b1;
        --phone-subtle: #b9bcc2;
        --phone-indicator: #d8dadd;
        --phone-mark-background: #303b34;
        --phone-capsule-background: rgba(22, 24, 28, 0.86);
        --phone-capsule-border: rgba(226, 228, 232, 0.17);
        --phone-capsule-divider: rgba(226, 228, 232, 0.14);
        --phone-capsule-shadow: rgba(2, 3, 5, 0.24);
        --phone-chart-bar: #3b4147;
        --phone-unit: #a9acb4;
        --phone-link: #91d6a2;
