</vpt-tailwind-showcase>

<script>
    class VptTailwindShowcaseElement extends HTMLElement {
        // The observer is retained so leaving the viewport or disconnecting always stops the synchronized demo.
        private observer: IntersectionObserver | null = null
        // Visibility is the only mutable presentation state shared by viewport, tab, and motion-preference changes.
        private isVisible = false
        private readonly reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

        connectedCallback(): void {
            if (this.observer !== null) return

            const stage = this.querySelector<HTMLElement>('.tailwind-stage')
            if (stage === null) throw new Error('Tailwind showcase requires a stage')

            this.observer = new IntersectionObserver(
                (entries) => {
                    this.isVisible = entries.some((entry) => entry.isIntersecting)
                    this.syncAnimation()
                },
                { threshold: 0.15 }
            )
            this.observer.observe(stage)
            this.reducedMotion.addEventListener('change', this.syncAnimation)
            document.addEventListener('visibilitychange', this.syncAnimation)
        }

        disconnectedCallback(): void {
            this.observer?.disconnect()
            this.observer = null
            this.reducedMotion.removeEventListener('change', this.syncAnimation)
            document.removeEventListener('visibilitychange', this.syncAnimation)
            this.isVisible = false
            this.classList.remove('is-live')
        }

        private readonly syncAnimation = (): void => {
            this.classList.toggle('is-live', this.isVisible && !document.hidden && !this.reducedMotion.matches)
        }
    }

    if (customElements.get('vpt-tailwind-showcase') === undefined) {
        customElements.define('vpt-tailwind-showcase', VptTailwindShowcaseElement)
    }
</script>

<style>
    vpt-tailwind-showcase {
        --style-hmr-cycle: 8s;
        display: block;
    }

    .tailwind-stage {
        --tailwind-demo-height: 41rem;
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(22rem, 0.8fr);
        align-items: center;
        gap: clamp(1.25rem, 3vw, 2rem);
    }

    .code-window,
    .phone-preview {
        min-width: 0;
        margin: 0;
    }

    .code-window {
        display: grid;
        position: relative;
        z-index: 1;
        border: 1px solid var(--vpt-border);
        border-radius: var(--home-panel-radius);
        box-shadow: var(--home-panel-shadow);
        overflow: hidden;
        grid-template-rows: auto minmax(0, 1fr) auto;
        height: var(--tailwind-demo-height);
        min-height: 0;
        background: #10251a;
        color: #dce9de;
    }

    .code-toolbar {
        display: grid;
        position: relative;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        min-height: 3.25rem;
        padding-inline: 1rem;
        border-bottom: 1px solid rgba(190, 224, 197, 0.12);
        background: #142c1f;
    }

    .window-controls {
        display: flex;
        gap: 0.4rem;
    }

    .window-controls i {
        width: 0.62rem;
        height: 0.62rem;
        margin: 0;
        border-radius: 50%;
        background: #ed967c;
    }

    .window-controls i:nth-child(2) {
        background: #e5c65c;
    }

    .window-controls i:nth-child(3) {
        background: #57b870;
    }

    .code-file {
        color: #a9b9ad;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: var(--home-font-size-small);
        text-align: center;
    }

    .tailwind-badge {
        display: flex;
        align-items: center;
        justify-self: end;
        gap: 0.35rem;
        color: #8fcea0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: var(--home-font-size-small);
    }

    .tailwind-badge i,
    .app-mark i {
        display: block;
        width: 0.7rem;
        height: 0.32rem;
        margin: 0;
        border-top: 0.14rem solid currentColor;
        border-radius: 50%;
        transform: skewX(-28deg);
    }

    .tailwind-badge i::after {
        display: block;
        width: 0.7rem;
        height: 0.32rem;
        margin: 0.08rem 0 0 0.35rem;
        border-top: 0.14rem solid currentColor;
        border-radius: 50%;
        content: '';
    }

    .code-editor {
        padding: 1.15rem 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        color: #d8e4da;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: var(--home-font-size-small);
        line-height: 1.8;
        overflow: auto;
        scrollbar-color: rgba(144, 198, 155, 0.35) transparent;
    }

    .code-editor code {
        display: grid;
        min-width: max-content;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        color: inherit;
        font: inherit;
    }

    .code-line {
        display: grid;
        grid-template-columns: 2.7rem auto;
        align-items: center;
        min-height: 1.55rem;
        padding-right: 1.5rem;
    }

    .code-line.active {
        position: relative;
        background: linear-gradient(90deg, rgba(103, 196, 124, 0.11), transparent 88%);
        box-shadow: inset 2px 0 #62c47b;
    }

    .hmr-edit-line::before {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(90deg, rgba(239, 152, 127, 0.15), transparent 88%),
            #10251a;
        box-shadow: inset 2px 0 #ef987f;
        content: '';
        opacity: 0;
        pointer-events: none;
    }

    .hmr-edit-line > * {
        position: relative;
    }

    .code-line > i {
        padding-right: 0.85rem;
        color: #546b5b;
        font-style: normal;
        text-align: right;
        user-select: none;
    }

    .code-line > span {
        white-space: pre;
    }

    .code-line b,
    .code-line em {
        font-style: normal;
        font-weight: 500;
    }

    .token-keyword {
        color: #ef987f;
    }

    .token-function {
        color: #e7cf75;
    }

    .token-tag {
        color: #80d696;
    }

    .token-attribute {
        color: #9bc4ee;
    }

    .token-string {
        color: #d9e78a;
    }

    .code-value {
        display: inline-grid;
        position: relative;
        border-radius: 0.2rem;
    }

    .code-value > * {
        display: inline-flex;
        grid-area: 1 / 1;
        align-items: center;
    }

    .code-value-after {
        opacity: 0;
        transform: translateY(0.18rem);
    }

    .code-value-after .token-string {
        color: #ffc1ad;
    }

    .code-caret {
        display: inline-block;
        width: 1px;
        height: 1.15em;
        margin-inline: 0.08rem;
        background: #ffe6a3;
        opacity: 0;
    }

