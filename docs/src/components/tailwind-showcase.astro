        margin-left: 0.28rem;
    }

    .app-header > strong {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 1.05rem;
    }

    .wechat-capsule {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        width: 4.75rem;
        height: 2rem;
        margin-left: auto;
        border: 1px solid var(--phone-capsule-border);
        border-radius: 999px;
        background: var(--phone-capsule-background);
        box-shadow: 0 0.15rem 0.4rem var(--phone-capsule-shadow);
