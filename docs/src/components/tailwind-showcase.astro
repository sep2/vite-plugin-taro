        transform-box: border-box;
        transform-style: preserve-3d;
        transform-origin: center;
    }

    .phone-speaker {
        position: absolute;
        z-index: 2;
        top: 0.95rem;
        left: 50%;
        width: 4.5rem;
        height: 1.25rem;
        border-radius: 999px;
        background: #0b1d13;
        transform: translateX(-50%);
