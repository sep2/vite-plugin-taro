---
import '../styles/vpt-theme.css'

// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import SubpackageOutputDiagram from './diagrams/subpackage-output-diagram.astro'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import SubpackageSourceDiagram from './diagrams/subpackage-source-diagram.astro'

interface Props {
    headingLevel: 2 | 3
}

// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const { headingLevel } = Astro.props
---

<vpt-subpackage-diagram class="automatic-subpackages-diagram vpt-theme">
    <div class="package-flow">
        <SubpackageSourceDiagram headingLevel={headingLevel} />

        <div class="package-planner" role="img" aria-label="VPT 自动规划模块位置">
            <span class="planner-flow planner-flow-in" aria-hidden="true"></span>
            <span class="planner-flow planner-flow-out planner-flow-out-one" aria-hidden="true"></span>
            <span class="planner-flow planner-flow-out planner-flow-out-two" aria-hidden="true"></span>
            <div class="planner-anchor">
                <div class="planner-core">
                    <span>VPT</span>
                    <small>自动规划</small>
                </div>
            </div>
            <ul>
                <li>依赖分析</li>
                <li>体积计算</li>
                <li>资源类别</li>
                <li>动态边界</li>
                <li>拆包合并</li>
            </ul>
        </div>

        <SubpackageOutputDiagram headingLevel={headingLevel} />
    </div>
</vpt-subpackage-diagram>

<script>
    class VptSubpackageDiagramElement extends HTMLElement {
        // The observer is retained so animation work exists only while the diagram is visible.
        private observer: IntersectionObserver | null = null
        // Visibility is the only mutable presentation state shared by viewport, tab, and motion-preference changes.
        private isVisible = false
        private readonly reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

        connectedCallback(): void {
            if (this.observer !== null) return

            this.observer = new IntersectionObserver(
                (entries) => {
                    this.isVisible = entries.some((entry) => entry.isIntersecting)
                    this.syncAnimation()
                },
                { threshold: 0.15 }
            )
            this.observer.observe(this)
            this.reducedMotion.addEventListener('change', this.syncAnimation)
            document.addEventListener('visibilitychange', this.syncAnimation)
        }

        disconnectedCallback(): void {
            this.observer?.disconnect()
            this.observer = null
            this.reducedMotion.removeEventListener('change', this.syncAnimation)
            document.removeEventListener('visibilitychange', this.syncAnimation)
            this.isVisible = false
            this.classList.remove('is-live')
        }

        private readonly syncAnimation = (): void => {
            this.classList.toggle('is-live', this.isVisible && !document.hidden && !this.reducedMotion.matches)
        }
    }

    if (customElements.get('vpt-subpackage-diagram') === undefined) {
        customElements.define('vpt-subpackage-diagram', VptSubpackageDiagramElement)
    }
</script>

<style>
    .automatic-subpackages-diagram {
        --diagram-content-gap: clamp(2.25rem, 4vw, 3rem);
        --diagram-branch-gap: clamp(3rem, 4vw, 3.5rem);
        --diagram-footer-gap: clamp(2.25rem, 4vw, 3rem);
        --diagram-font-size-title: var(--home-font-size-title, clamp(1.25rem, 2vw, 1.55rem));
        --diagram-font-size-body: var(--home-font-size-body, 1rem);
        --diagram-panel-radius: var(--home-panel-radius, 1.5rem);
        --diagram-panel-shadow: var(--home-panel-shadow, 0 24px 60px var(--vpt-shadow));
        --planner-connector-gap: clamp(1rem, 2vw, 1.5rem);
        --subpackage-animation-duration: 9s;
        display: block;
        container: automatic-subpackages-layout / inline-size;
    }

    :global(:where(.automatic-subpackages-diagram *)) {
        box-sizing: border-box;
        margin: 0;
    }

    .automatic-subpackages-diagram :global(ul) {
        padding: 0;
        list-style: none;
    }

    .package-flow {
        display: grid;
        position: relative;
        grid-template-columns: minmax(0, 1fr) 9.5rem minmax(0, 1fr);
        container: automatic-subpackages / inline-size;
        align-items: stretch;
        gap: var(--planner-connector-gap);
        margin: 0;
    }

    .automatic-subpackages-diagram :global(.diagram-panel),
    .package-planner {
        position: relative;
        z-index: 1;
        margin: 0;
    }

    .automatic-subpackages-diagram :global(.diagram-panel) {
        display: flex;
        min-width: 0;
        height: 100%;
        flex-direction: column;
        padding: clamp(1.25rem, 3vw, 2rem);
        border: 1px solid var(--vpt-border);
        border-radius: var(--diagram-panel-radius);
        background: var(--vpt-card-background);
        box-shadow: var(--diagram-panel-shadow);
    }

    .automatic-subpackages-diagram :global(.diagram-heading) {
        text-align: left;
    }

    .automatic-subpackages-diagram :global(.diagram-heading span) {
        color: var(--vpt-accent);
        font-size: var(--home-font-size-small);
        font-weight: 750;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .automatic-subpackages-diagram :global(.diagram-heading :is(h2, h3)) {
        margin: 0.35rem 0 0;
        color: var(--vpt-heading);
        font-size: var(--diagram-font-size-title);
    }

    .automatic-subpackages-diagram :global(.diagram-footer) {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 3rem;
        margin: auto 0 0;
        padding-top: 1.15rem;
        border-top: 1px solid var(--vpt-border);
        text-align: center;
    }

    .package-planner {
        --planner-orbit-rotation: 7deg;
        display: grid;
        place-items: center;
    }

    .package-planner::before,
    .package-planner::after {
        content: '';
        position: absolute;
        top: 50%;
        width: clamp(1rem, 2vw, 1.5rem);
        border-top: 1.5px dashed var(--vpt-border-strong);
    }

    .package-planner::before {
        right: 100%;
    }

    .package-planner::after {
        left: 100%;
    }

    .planner-flow {
        position: absolute;
        z-index: 3;
        top: calc(50% - 0.24rem);
        width: 0.48rem;
        height: 0.48rem;
        margin: 0;
        border: 1px solid color-mix(in srgb, var(--vpt-accent) 55%, white);
        border-radius: 50%;
        background: var(--vpt-accent);
        box-shadow: 0 0 0 0.28rem color-mix(in srgb, var(--vpt-accent) 16%, transparent);
        opacity: 0;
        pointer-events: none;
    }

    .planner-flow-in {
        --planner-flow-x: calc(4.75rem + var(--planner-connector-gap));
        --planner-flow-y: 0rem;
        left: calc(0rem - var(--planner-connector-gap));
        background: #e88870;
    }

    .planner-flow-out {
        --planner-flow-x: calc(4.75rem + var(--planner-connector-gap));
        --planner-flow-y: 0rem;
        left: calc(50% - 0.24rem);
    }

    .planner-anchor {
        display: grid;
        width: 9.5rem;
        height: 9.5rem;
        margin: 0;
        place-items: center;
    }

    .planner-core {
        display: block;
        position: relative;
        width: 5.5rem;
        height: 5.5rem;
        margin: 0;
        border: 1px solid var(--vpt-border-strong);
        border-radius: 50%;
        background: var(--vpt-icon-background);
        box-shadow:
            0 0 0 0.65rem color-mix(in srgb, var(--vpt-icon-background) 58%, transparent),
            0 18px 35px var(--vpt-shadow-strong);
        text-align: center;
    }

    .planner-core::before,
    .planner-core::after {
        content: '';
        position: absolute;
        border: 1px dashed var(--vpt-border-strong);
        border-radius: 50%;
        inset: -1.25rem;
    }

    .planner-core::after {
        border-color: rgba(232, 136, 112, 0.45);
        inset: -2rem;
    }

    .planner-core span {
        position: absolute;
        top: calc(50% - 0.15rem);
        left: 50%;
        color: var(--vpt-heading-strong);
        font-family: Georgia, 'Times New Roman', serif;
        padding-bottom: 0.5rem;
        font-size: var(--diagram-font-size-title);
        font-weight: 700;
        line-height: 1;
        transform: translate(-50%, -50%);
    }

    .planner-core small {
        position: absolute;
        top: calc(50% + 0.7rem);
        left: 50%;
        color: var(--vpt-accent);
        font-size: var(--home-font-size-small);
        font-weight: 700;
        line-height: 1;
        transform: translateX(-50%);
        white-space: nowrap;
    }

    .package-planner ul {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 9.5rem;
        height: 9.5rem;
        margin: 0;
        padding: 0;
        color: var(--vpt-muted);
        font-size: var(--home-font-size-small);
        list-style: none;
        pointer-events: none;
        transform: translate(-50%, -50%);
    }

    .package-planner li {
        --planner-orbit-angle: calc(
            var(--planner-orbit-base-angle) + var(--planner-orbit-rotation)
        );
        display: flex;
        position: absolute;
        z-index: 2;
        top: calc(50% + (sin(var(--planner-orbit-angle)) * 50%));
        left: calc(50% + (cos(var(--planner-orbit-angle)) * 50%));
        align-items: center;
        justify-content: center;
        padding: 0.32rem 0.1rem;
        border: 0;
        background: transparent;
        color: color-mix(in srgb, var(--vpt-muted) 68%, var(--vpt-node-background));
        font-size: 0.8333em;
        font-weight: 600;
        letter-spacing: 0.03em;
        line-height: 1;
        text-shadow:
            0 0 0.3rem var(--vpt-page-bg),
            0 0 0.65rem var(--vpt-page-bg),
            0 0 0.9rem var(--vpt-page-bg);
        white-space: nowrap;
        transform: translate(-50%, -50%);
    }

    .package-planner li:nth-child(1) {
        --planner-orbit-base-angle: -162deg;
    }

    .package-planner li:nth-child(2) {
        --planner-orbit-base-angle: -18deg;
    }

    .package-planner li:nth-child(3) {
        --planner-orbit-base-angle: 54deg;
    }

    .package-planner li:nth-child(4) {
        --planner-orbit-base-angle: 126deg;
    }

    .package-planner li:nth-child(5) {
        --planner-orbit-base-angle: -90deg;
    }

    .automatic-subpackages-diagram.is-live :global(.source-root) {
        animation: subpackage-source-root var(--subpackage-animation-duration) ease-in-out infinite;
    }

    .automatic-subpackages-diagram.is-live :global(.async-node) {
        animation: subpackage-async-node var(--subpackage-animation-duration) ease-in-out infinite;
    }

    .automatic-subpackages-diagram.is-live :global(.dynamic-label) {
        animation: subpackage-dynamic-label var(--subpackage-animation-duration) ease-in-out infinite;
    }

    .automatic-subpackages-diagram.is-live :global(.report-branch::before),
    .automatic-subpackages-diagram.is-live :global(.async-node::after),
    .automatic-subpackages-diagram.is-live :global(.feature-dependencies::before),
    .automatic-subpackages-diagram.is-live :global(.mini-node::before) {
        animation: subpackage-source-connector var(--subpackage-animation-duration) ease-in-out infinite;
    }

    .automatic-subpackages-diagram.is-live :global(.mini-node) {
        animation: subpackage-source-dependency var(--subpackage-animation-duration) ease-in-out infinite;
    }

    .automatic-subpackages-diagram.is-live :global(.mini-node:nth-child(2)) {
        animation-delay: 120ms;
    }

    .automatic-subpackages-diagram.is-live :global(.mini-node:nth-child(3)) {
        animation-delay: 240ms;
    }

    .automatic-subpackages-diagram.is-live .package-planner::before {
        animation: subpackage-planner-input var(--subpackage-animation-duration) ease-in-out infinite;
    }

    .automatic-subpackages-diagram.is-live .package-planner::after {
        animation: subpackage-planner-output var(--subpackage-animation-duration) ease-in-out infinite;
    }

    .automatic-subpackages-diagram.is-live .planner-flow-in {
        animation: subpackage-flow-in var(--subpackage-animation-duration) linear infinite;
    }

    .automatic-subpackages-diagram.is-live .planner-flow-out {
        animation: subpackage-flow-out var(--subpackage-animation-duration) linear infinite;
    }

    .automatic-subpackages-diagram.is-live .planner-flow-out-two {
        animation-delay: 320ms;
    }

    .automatic-subpackages-diagram.is-live .planner-core {
        animation: subpackage-planner-core var(--subpackage-animation-duration) ease-in-out infinite;
    }

    .automatic-subpackages-diagram.is-live .planner-core::before {
        animation: subpackage-planner-ring var(--subpackage-animation-duration) linear infinite;
    }

    .automatic-subpackages-diagram.is-live .planner-core::after {
        animation: subpackage-planner-ring-reverse var(--subpackage-animation-duration) linear infinite;
    }

    .automatic-subpackages-diagram.is-live .package-planner li {
        animation: subpackage-planner-criterion var(--subpackage-animation-duration) ease-in-out infinite;
    }

    .automatic-subpackages-diagram.is-live .package-planner li:nth-child(2) {
        animation-delay: 100ms;
    }

    .automatic-subpackages-diagram.is-live .package-planner li:nth-child(3) {
        animation-delay: 200ms;
    }

    .automatic-subpackages-diagram.is-live .package-planner li:nth-child(4) {
        animation-delay: 300ms;
    }

    .automatic-subpackages-diagram.is-live .package-planner li:nth-child(5) {
        animation-delay: 400ms;
    }

    .automatic-subpackages-diagram.is-live :global(.main-package) {
        animation: subpackage-main-package var(--subpackage-animation-duration) ease-in-out infinite;
    }

    .automatic-subpackages-diagram.is-live :global(.subpackage-grid .package-card) {
        animation: subpackage-output-card var(--subpackage-animation-duration) ease-in-out infinite;
    }

    .automatic-subpackages-diagram.is-live :global(.subpackage-grid .package-card:nth-child(2)) {
        animation-delay: 220ms;
    }

    .automatic-subpackages-diagram.is-live :global(.subpackage-grid .module-chip) {
        animation: subpackage-output-module var(--subpackage-animation-duration) ease-in-out infinite;
    }

    .automatic-subpackages-diagram.is-live :global(.subpackage-grid .package-card:nth-child(2) .module-chip) {
        animation-delay: 220ms;
    }

    .automatic-subpackages-diagram.is-live :global(.cross-package-note svg) {
        animation: subpackage-cross-package var(--subpackage-animation-duration) ease-in-out infinite;
        transform-origin: center;
    }

    @keyframes subpackage-source-root {
        0%,
        3%,
        13%,
        100% {
            transform: translateY(0) scale(1);
        }

        7% {
            transform: translateY(-0.16rem) scale(1.015);
        }
    }

    @keyframes subpackage-async-node {
        0%,
        10%,
        27%,
        100% {
            transform: translateY(0) scale(1);
        }

        15%,
        22% {
            transform: translateY(-0.16rem) scale(1.018);
        }
    }

    @keyframes subpackage-dynamic-label {
        0%,
        9%,
        27%,
        100% {
            opacity: 0.72;
            transform: translateX(-50%) scale(1);
        }

        14%,
        22% {
            opacity: 1;
            transform: translateX(-50%) scale(1.08);
        }
    }

    @keyframes subpackage-source-connector {
        0%,
        10%,
        29%,
        100% {
            opacity: 0.45;
        }

        16%,
        25% {
            opacity: 1;
        }
    }

    @keyframes subpackage-source-dependency {
        0%,
        15%,
        30%,
        100% {
            opacity: 0.72;
            transform: translateY(0);
        }

        20%,
        26% {
            opacity: 1;
            transform: translateY(-0.14rem);
        }
    }

    @keyframes subpackage-planner-input {
        0%,
        19%,
        34%,
        100% {
            opacity: 0.45;
        }

        23%,
        31% {
            opacity: 1;
        }
    }

    @keyframes subpackage-planner-output {
        0%,
        48%,
        62%,
        100% {
            opacity: 0.45;
        }

        52%,
        59% {
            opacity: 1;
        }
    }

    @keyframes subpackage-flow-in {
        0%,
        20% {
            opacity: 0;
            transform: translate(0, 0) scale(0.72);
        }

        23% {
            opacity: 1;
        }

        31% {
            opacity: 1;
            transform: translate(var(--planner-flow-x), var(--planner-flow-y)) scale(1);
        }

        34%,
        100% {
            opacity: 0;
            transform: translate(var(--planner-flow-x), var(--planner-flow-y)) scale(0.72);
        }
    }

    @keyframes subpackage-flow-out {
        0%,
        49% {
            opacity: 0;
            transform: translate(0, 0) scale(0.72);
        }

        52% {
            opacity: 1;
        }

        59% {
            opacity: 1;
            transform: translate(var(--planner-flow-x), var(--planner-flow-y)) scale(1);
        }

        62%,
        100% {
            opacity: 0;
            transform: translate(var(--planner-flow-x), var(--planner-flow-y)) scale(0.72);
        }
    }

    @keyframes subpackage-planner-core {
        0%,
        27%,
        51%,
        100% {
            transform: scale(1);
        }

        32%,
        41% {
            transform: scale(1.045);
        }

        36%,
        46% {
            transform: scale(0.985);
        }
    }

    @keyframes subpackage-planner-ring {
        0%,
        27% {
            transform: rotate(0deg);
        }

        51%,
        100% {
            transform: rotate(360deg);
        }
    }

    @keyframes subpackage-planner-ring-reverse {
        0%,
        27% {
            transform: rotate(0deg);
        }

        51%,
        100% {
            transform: rotate(-360deg);
        }
    }

    @keyframes subpackage-planner-criterion {
        0%,
        28%,
        51%,
        100% {
            opacity: 0.72;
            transform: translate(-50%, -50%) scale(1);
        }

        34%,
        43% {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1.08);
        }
    }

    @keyframes subpackage-main-package {
        0%,
        52%,
        66%,
        100% {
            opacity: 0.86;
            transform: translateY(0);
        }

        57%,
        62% {
            opacity: 1;
            transform: translateY(-0.12rem);
        }
    }

    @keyframes subpackage-output-card {
        0%,
        58%,
        78%,
        100% {
            opacity: 0.82;
            transform: translateY(0) scale(1);
        }

        64%,
        73% {
            opacity: 1;
            transform: translateY(-0.18rem) scale(1.012);
        }
    }

    @keyframes subpackage-output-module {
        0%,
        62%,
        81%,
        100% {
            opacity: 0.78;
            transform: translateX(0);
        }

        68%,
        76% {
            opacity: 1;
            transform: translateX(0.12rem);
        }
    }

    @keyframes subpackage-cross-package {
        0%,
        72%,
        88%,
        100% {
            transform: rotate(0deg) scale(1);
        }

        78%,
        83% {
            transform: rotate(180deg) scale(1.16);
        }
    }

    @container automatic-subpackages-layout (max-width: 64rem) {
        .package-flow {
            grid-template-columns: 1fr;
            max-width: 42rem;
            margin-inline: auto;
            gap: 3rem;
        }

        .automatic-subpackages-diagram :global(.diagram-panel) {
            height: auto;
        }

        .package-planner {
            min-height: 9.5rem;
        }

        .package-planner::before,
        .package-planner::after {
            left: 50%;
            width: 0;
            height: 3rem;
            border-top: 0;
            border-left: 1.5px dashed var(--vpt-border-strong);
        }

        .package-planner::before {
            top: auto;
            right: auto;
            bottom: 100%;
        }

        .package-planner::after {
            top: 100%;
        }

        .planner-flow-in {
            --planner-flow-x: 0rem;
            --planner-flow-y: 7.75rem;
            top: -3rem;
            left: calc(50% - 0.24rem);
        }

        .planner-flow-out {
            --planner-flow-x: 0rem;
            --planner-flow-y: 7.75rem;
            top: calc(50% - 0.24rem);
            left: calc(50% - 0.24rem);
        }
    }

    @container automatic-subpackages-layout (max-width: 40rem) {
        .package-flow {
            --diagram-content-gap: 2.25rem;
            --diagram-branch-gap: 3rem;
            --diagram-footer-gap: 2.5rem;
        }

        .automatic-subpackages-diagram :global(.diagram-panel) {
            padding: 1.1rem;
        }

    }

</style>
