---
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import { Icon } from '@astrojs/starlight/components'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import AutomaticSubpackagesDiagram from './automatic-subpackages-diagram.astro'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import HomeSectionHeading from './home-section-heading.astro'
---

<section class="home-section subpackage-showcase" aria-labelledby="subpackage-title">
    <HomeSectionHeading
        id="subpackage-title"
        kicker="只决定何时加载，不再关心放在哪个包"
        title="动态导入，自动分包"
        description="像 Web 应用一样组织源码。VPT 沿着模块图识别同步启动链与按需边界，再自动生成符合微信与支付宝限制的主包和分包。"
        align="center"
    />

    <AutomaticSubpackagesDiagram headingLevel={3} />

    <div class="subpackage-benefits">
        <article class="benefit-card">
            <span class="benefit-icon"><Icon name="approve-check-circle" /></span>
            <span><strong>零手写配置</strong><small>无需维护 subPackages</small></span>
        </article>
        <article class="benefit-card">
            <span class="benefit-icon"><Icon name="code-branch" /></span>
            <span><strong>依赖自动分包</strong><small>功能内部继续静态 import</small></span>
        </article>
        <article class="benefit-card">
            <span class="benefit-icon"><Icon name="puzzle" /></span>
            <span><strong>自动满足包限制</strong><small>突破小程序 2M 单包限制</small></span>
        </article>
    </div>

    <a class="subpackage-link" href="/guides/automatic-subpackages/">
        查看全自动分包指南 <span aria-hidden="true">→</span>
    </a>
</section>

<style>
    .subpackage-benefits {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-auto-rows: 1fr;
        gap: 0.75rem;
        margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    }

    .benefit-card {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: 0.85rem;
        height: 100%;
        min-height: 6.5rem;
        margin: 0;
        padding: 1.15rem;
        border: 1px solid var(--vpt-border);
        border-radius: var(--home-card-radius);
        background:
            radial-gradient(circle at 100% 0, color-mix(in srgb, var(--vpt-icon-background) 72%, transparent), transparent 55%),
            var(--vpt-surface);
        box-shadow: 0 12px 30px var(--vpt-shadow);
    }

    .benefit-icon {
        display: grid;
        width: 2.65rem;
        height: 2.65rem;
        border: 1px solid var(--vpt-border);
        border-radius: 0.85rem;
        background: var(--vpt-icon-background);
        color: var(--vpt-accent);
        place-items: center;
        transform: rotate(-3deg);
    }

    .benefit-icon :global(svg) {
        width: 1.3rem;
        height: 1.3rem;
    }

    .benefit-card > span:last-child {
        display: grid;
        min-width: 0;
        gap: 0.2rem;
    }

    .benefit-card strong {
        color: var(--vpt-heading-strong);
        font-size: var(--home-font-size-body);
    }

    .benefit-card small {
        color: var(--vpt-muted);
        font-size: var(--home-font-size-small);
        line-height: 1.5;
    }

    .subpackage-link {
        display: block;
        width: fit-content;
        margin: var(--home-section-heading-gap) auto 0;
        color: var(--vpt-accent-strong);
        font-weight: 700;
        text-decoration: none;
    }

    .subpackage-link:hover {
        text-decoration: underline;
    }

    @media (max-width: 40rem) {
        .subpackage-benefits {
            grid-template-columns: 1fr;
        }
    }
</style>
