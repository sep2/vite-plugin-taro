---
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import { Icon } from '@astrojs/starlight/components'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import HomeSectionHeading from './home-section-heading.astro'

// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const features = [
    {
        title: 'Vite 8',
        icon: 'seti:vite',
        description: '由 Vite 8 和 Rolldown 驱动开发与生产构建，带来快速启动、增量构建和现代前端工具链。',
        tags: ['Vite 8', 'Rolldown']
    },
    {
        title: 'React 19',
        icon: 'seti:react',
        description: '以 React 19 运行 App、页面和组件，直接使用 Hooks、Suspense 与 React.lazy()。',
        tags: ['Hooks', 'Suspense', 'React.lazy()']
    },
    {
        title: '微信小程序热更新',
        icon: 'random',
        description: '基于 Vite 模块图和 React Refresh，修改组件时保留 App、页面、深层组件与输入状态。',
        tags: ['React Refresh', '状态保留']
    },
    {
        title: '全自动分包',
        icon: 'puzzle',
        description: '动态 import() 探索加载边界，自动规划主包与分包，应用层不再关心单包 2M 限制。',
        tags: ['动态加载', '自动规划']
    },
    {
        title: 'Taro 组件与 API',
        icon: 'code-branch',
        description: '继续使用熟悉的 Taro 组件与 API，在一份 React 源码中连接微信小程序和 Web。',
        tags: ['跨端组件', '统一 API']
    },
    {
        title: '微信原生组件',
        icon: 'setting',
        description: '原生组件与 React 双向调用，并自然参与全自动分包，无需维护额外的胶水层。',
        tags: ['双向通信', '自动分包']
    },
    {
        title: 'Skyline 渲染模式',
        icon: 'mobile-android',
        description: '支持全局或按页面启用 Skyline，让复杂交互获得更流畅、更稳定的渲染体验。',
        tags: ['按页启用', '流畅渲染']
    },
    {
        title: 'Tailwind CSS v4',
        icon: 'pencil',
        description: '默认模板开箱即用，候选类和样式输出自动适配微信小程序与 Web。',
        tags: ['零配置', '跨端样式']
    },
    {
        title: '广泛测试覆盖',
        icon: 'approve-check-circle',
        description: '覆盖编译、分包、热更新、样式生成与运行时边界；大量单元测试和回归用例让每次迭代都有可靠保障。',
        tags: ['单元测试', '回归保障']
    }
] as const
---

<section class="home-section home-features" aria-labelledby="features-title">
    <svg class="lower-botanical lower-botanical-left" viewBox="-24 -24 288 190" aria-hidden="true">
        <use href="#botanical-sprig-bloom" />
    </svg>
    <svg class="lower-botanical lower-botanical-right" viewBox="-24 -24 288 190" aria-hidden="true">
        <use href="#botanical-sprig" />
    </svg>

    <HomeSectionHeading
        id="features-title"
        kicker="从开发体验到生产交付"
        title="为现代微信小程序而生"
        description="熟悉的 React 开发方式，完整的微信小程序能力，不再被传统工具链拖慢。"
        align="center"
    />

    <div class="feature-grid">
        {
            features.map(({ title, icon, description, tags }) => (
                <article class="feature-card">
                    <div class="feature-heading">
                        <span class="feature-icon"><Icon name={icon} /></span>
                        <h3>{title}</h3>
                    </div>
                    <p>{description}</p>
                    <div class="feature-tags">
                        {tags.map((tag) => <span>{tag}</span>)}
                    </div>
                </article>
            ))
        }
    </div>

    <a class="feature-docs-link" href="/guides/quick-start/">
        <Icon name="open-book" />
        <span>查看文档</span>
        <Icon name="right-arrow" />
    </a>
</section>

<style>
    .home-features {
        --feature-cta-space: var(--home-section-space);
        position: relative;
    }

    .home-features :global(.home-section-heading),
    .feature-grid,
    .feature-docs-link {
        position: relative;
        z-index: 1;
    }

    .lower-botanical {
        position: absolute;
        z-index: 0;
        width: clamp(11rem, 18vw, 16rem);
        height: auto;
        opacity: 0.2;
        pointer-events: none;
    }

    .lower-botanical-left {
        top: 28%;
        left: clamp(-7rem, -6vw, -4rem);
        transform: rotate(-16deg);
    }

    .lower-botanical-right {
        right: clamp(-7rem, -6vw, -4rem);
        bottom: 14%;
        transform: scaleX(-1) rotate(-12deg);
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 1rem;
    }

    .feature-card {
        display: flex;
        grid-column: span 2;
        flex-direction: column;
        min-height: 18rem;
        padding: clamp(1.25rem, 3vw, 2rem);
        border: 1px solid var(--vpt-border);
        border-radius: var(--home-card-radius);
        background: var(--vpt-card-background);
        box-shadow: 0 18px 50px var(--vpt-shadow);
        transition:
            border-color 180ms ease,
            box-shadow 180ms ease,
            transform 180ms ease;
    }

    .feature-card:nth-child(3n + 1) {
        transform: rotate(-0.3deg);
    }

    .feature-card:nth-child(3n + 2) {
        transform: translateY(0.35rem) rotate(0.22deg);
    }

    .feature-card:nth-child(3n) {
        transform: rotate(0.28deg);
    }

    .feature-card:hover {
        border-color: var(--vpt-border-strong);
        box-shadow: 0 22px 55px var(--vpt-shadow-strong);
        transform: translateY(-3px) rotate(0deg);
    }

    .feature-heading {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }

    .feature-icon {
        display: grid;
        width: 3.25rem;
        height: 3.25rem;
        border: 1px solid var(--vpt-border);
        border-radius: 1rem;
        background: var(--vpt-icon-background);
        color: var(--vpt-accent);
        place-items: center;
        transform: rotate(-3deg);
    }

    .feature-icon :global(svg) {
        width: 1.8rem;
        height: 1.8rem;
    }

    .feature-heading h3 {
        margin: 0;
        color: var(--vpt-heading);
        font-size: var(--home-font-size-title);
    }

    .feature-card > p {
        margin: 1.35rem 0 1.5rem;
        color: var(--vpt-text);
        font-size: var(--home-font-size-body);
        line-height: var(--home-line-height-body);
    }

    .feature-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: auto;
    }

    .feature-tags span {
        padding: 0.3rem 0.65rem;
        border: 1px solid var(--vpt-border);
        border-radius: 999px;
        background: var(--vpt-chip-background);
        color: var(--vpt-chip-text);
        font-size: var(--home-font-size-small);
    }

    .feature-docs-link {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        width: fit-content;
        margin: var(--feature-cta-space) auto 0;
        padding: 0.8rem 1.15rem;
        border: 1px solid var(--vpt-border-strong);
        border-radius: 999px;
        background: var(--vpt-surface);
        box-shadow: 0 12px 28px var(--vpt-shadow);
        color: var(--vpt-accent-strong);
        font-weight: 700;
        text-decoration: none;
        transition:
            border-color 180ms ease,
            box-shadow 180ms ease,
            transform 180ms ease;
    }

    .feature-docs-link :global(svg) {
        width: 1.05rem;
        height: 1.05rem;
    }

    .feature-docs-link:hover {
        border-color: var(--vpt-border-strong);
        box-shadow: 0 16px 34px var(--vpt-shadow-strong);
        transform: translateY(-2px);
    }

    .feature-docs-link:focus-visible {
        outline: 3px solid color-mix(in srgb, var(--vpt-accent) 45%, transparent);
        outline-offset: 4px;
    }

    @media (max-width: 64rem) {
        .feature-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .feature-card {
            grid-column: span 1;
        }

        .feature-card:last-child:nth-child(odd) {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 40rem) {
        .lower-botanical {
            width: 10rem;
            opacity: 0.14;
        }

        .lower-botanical-left {
            left: -4.5rem;
        }

        .lower-botanical-right {
            right: -4.5rem;
        }

        .feature-grid {
            grid-template-columns: 1fr;
        }

        .feature-card,
        .feature-card:last-child:nth-child(odd) {
            grid-column: span 1;
            min-height: auto;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .feature-card,
        .feature-docs-link {
            transition: none;
        }
    }
</style>
