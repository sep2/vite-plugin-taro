---
interface Props {
    href: string
}

// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const { href } = Astro.props
---

<a class="home-link" href={href}><slot /> <span aria-hidden="true">→</span></a>

<style>
    .home-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--vpt-border-strong);
        border-radius: 999px;
        background: var(--vpt-surface);
        box-shadow: 0 10px 24px var(--vpt-shadow);
        color: var(--vpt-accent-strong);
        font-size: var(--home-font-size-body);
        font-weight: 700;
        line-height: 1.75;
        text-decoration: none;
    }

    .home-link:hover {
        text-decoration: underline;
    }

    .home-link:focus-visible {
        outline: 3px solid color-mix(in srgb, var(--vpt-accent) 44%, transparent);
        outline-offset: 3px;
    }
</style>
