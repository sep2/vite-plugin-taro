---
import StarlightPageFrame from '@astrojs/starlight/components/PageFrame.astro'
import NavigationDrawerFrame from './navigation-drawer-frame.astro'

// Keep Starlight's menu toggle, native popover, and focus handling together on documentation pages.
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const Frame = Astro.locals.starlightRoute.hasSidebar ? StarlightPageFrame : NavigationDrawerFrame
---

<Frame>
    <slot name="header" slot="header" />
    <slot name="sidebar" slot="sidebar" />
    <slot />
</Frame>
