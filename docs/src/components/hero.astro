    <div class="proof-row">
        {
            proofPoints.map(({ icon, title, detail }) => (
                <div class="proof-point">
                    <span class="proof-icon">{icon}</span>
                    <span><strong>{title}</strong><small>{detail}</small></span>
                </div>
            ))
        }
    </div>
</div>

<style>
    @layer starlight.core {
        .hero {
            position: relative;
            isolation: isolate;
            width: 100%;
            padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 4vw, 4rem) 0;
            overflow: hidden;
            color: var(--vpt-text);
        }

        .botanical-definitions {
            position: absolute;
            width: 0;
            height: 0;
        }

        .botanical-branch,
        .background-mark {
            position: absolute;
            z-index: -1;
            pointer-events: none;
        }

        .botanical-branch {
            height: auto;
            fill: #4aa95f;
            transform-origin: center;
        }

        .botanical-top-left {
            top: -2.4rem;
            left: -0.25rem;
            width: clamp(13rem, 23vw, 21rem);
            opacity: 0.82;
            transform: rotate(-1.5deg);
        }

        .botanical-top-right {
            top: -1.7rem;
            right: -0.15rem;
            width: clamp(10rem, 18vw, 16rem);
            opacity: 0.72;
            transform: scaleX(-1) rotate(3deg);
        }

        .botanical-bottom-left {
            bottom: -1.8rem;
            left: 0;
            width: clamp(10rem, 17vw, 15.5rem);
            opacity: 0.68;
            transform: scaleY(-1) rotate(4deg);
        }

        .botanical-bottom-right {
            right: -0.35rem;
            bottom: -2.5rem;
            width: clamp(14rem, 24vw, 22rem);
            opacity: 0.76;
            transform: scale(-1) rotate(-3deg);
        }

        .background-mark {
            display: block;
        }

        .petal {
            width: 0.8rem;
            height: 1.35rem;
            border-radius: 70% 30% 70% 30%;
            background: #ee8a70;
            opacity: 0.78;
        }

        .petal-one {
            top: 9%;
            left: 32%;
            transform: rotate(38deg);
        }

        .petal-two {
            top: 14%;
            right: 32%;
            transform: rotate(-48deg);
        }

        .petal-three {
            right: 11%;
            bottom: 17%;
            transform: rotate(32deg);
        }

        .dot {
            width: 0.8rem;
            height: 0.8rem;
            border-radius: 50%;
            background: #64bb73;
            opacity: 0.8;
        }

        .dot-one {
            top: 7%;
            right: 24%;
        }

        .dot-two {
            bottom: 12%;
            left: 17%;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
            align-items: center;
            gap: clamp(2rem, 6vw, 6rem);
            width: min(100%, 74rem);
            margin-inline: auto;
        }

        .hero-copy {
            display: flex;
            align-items: center;
            flex-direction: column;
            text-align: center;
        }

        .eyebrow {
            margin-bottom: 2rem;
            color: var(--vpt-accent);
            font-size: clamp(0.78rem, 1.3vw, 1rem);
            font-weight: 650;
