                <path d="M72 121C77 89 99 76 125 88C111 115 92 126 72 121Z" fill="url('#botanical-leaf-gradient')" />
                <path d="M119 92C109 61 125 39 154 40C158 69 145 88 119 92Z" fill="url('#botanical-leaf-gradient')" />
                <path d="M164 55C182 28 207 24 228 43C207 64 184 68 164 55Z" fill="url('#botanical-leaf-gradient')" />
                <path d="M33 135C40 115 47 99 52 89M75 118C92 108 107 98 122 90M122 89C133 72 144 57 152 44M168 53C186 48 204 45 223 44" fill="none" stroke="#dbefca" stroke-linecap="round" stroke-width="1.9" opacity=".72" />
                <g fill="url('#botanical-flower-gradient')" transform="translate(91 108) scale(.82)">
                    <ellipse cy="-9" rx="6" ry="10" /><ellipse cx="8" rx="6" ry="10" transform="rotate(72 8 0)" /><ellipse cx="5" cy="8" rx="6" ry="10" transform="rotate(145 5 8)" /><ellipse cx="-6" cy="7" rx="6" ry="10" transform="rotate(215 -6 7)" /><ellipse cx="-8" rx="6" ry="10" transform="rotate(288 -8 0)" /><circle r="4" fill="#fff0bd" />
                </g>
                <path d="M193 34C196 17 208 10 220 18C214 32 205 38 193 34Z" fill="#f09a82" />
            </g>
        </defs>
    </svg>
    <svg class="botanical-branch botanical-top-left" viewBox="-24 -24 288 190" aria-hidden="true"><use href="#botanical-sprig" /></svg>
    <svg class="botanical-branch botanical-top-right" viewBox="-24 -24 288 190" aria-hidden="true"><use href="#botanical-sprig-airy" /></svg>
    <svg class="botanical-branch botanical-bottom-left" viewBox="-24 -24 288 190" aria-hidden="true"><use href="#botanical-sprig-berries" /></svg>
    <svg class="botanical-branch botanical-bottom-right" viewBox="-24 -24 288 190" aria-hidden="true"><use href="#botanical-sprig-bloom" /></svg>
    <span class="background-mark petal petal-one" aria-hidden="true"></span>
    <span class="background-mark petal petal-two" aria-hidden="true"></span>
    <span class="background-mark petal petal-three" aria-hidden="true"></span>
    <span class="background-mark dot dot-one" aria-hidden="true"></span>
    <span class="background-mark dot dot-two" aria-hidden="true"></span>

    <div class="hero-grid">
        <div class="hero-copy">
            <div class="eyebrow">— 用现代化前端工具链开发微信小程序 —</div>
            <a class="latest-version" href={latestPackageUrl} target="_blank" rel="noopener noreferrer">
                <span>最新版本</span>
                <strong>v{latestVersion}</strong>
            </a>
            <h1 id="_top" data-page-title set:html={title} />
            <div class="technology-line">
                <span>Vite 8</span><i>✿</i><span>React 19</span><i>✿</i><span>Tailwind 4</span>
            </div>
            {tagline && <div class="tagline"><span set:html={tagline} /></div>}
            {
                actions.length > 0 && (
                    <div class="actions">
                        {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
                            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                                {text}
                                {icon?.html && <Fragment set:html={icon.html} />}
                            </LinkButton>
                        ))}
                    </div>
                )
            }
        </div>

        <div class="rocket-stage" aria-hidden="true">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <svg class="rocket" viewBox="0 0 440 500">
                <defs>
                    <linearGradient id="rocket-body-gradient" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#fffef8" />
                        <stop offset=".56" stop-color="#f5f2df" />
                        <stop offset="1" stop-color="#dce9cf" />
                    </linearGradient>
                    <linearGradient id="rocket-green-gradient" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#9bd681" />
                        <stop offset=".48" stop-color="#51b660" />
                        <stop offset="1" stop-color="#267f48" />
                    </linearGradient>
                    <linearGradient id="rocket-dark-green-gradient" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0" stop-color="#1a683d" />
                        <stop offset=".5" stop-color="#3b9853" />
                        <stop offset="1" stop-color="#145b37" />
                    </linearGradient>
                    <radialGradient id="rocket-window-gradient" cx="35%" cy="28%" r="75%">
                        <stop offset="0" stop-color="#a5e68e" />
                        <stop offset=".48" stop-color="#55b967" />
                        <stop offset="1" stop-color="#238048" />
                    </radialGradient>
                    <g id="trail-leaf">
                        <path d="M0-14C8-10 10-2 6 6C3 11 0 14 0 14C-5 9-8 2-6-5C-5-10 0-14 0-14Z" fill="currentColor" stroke="#2b874a" stroke-width="1.4" />
                        <path d="M0-11C1-4 1 4 0 11M0-3L4-7M0 3L-4-1M0 7L3 4" fill="none" stroke="#e2efca" stroke-linecap="round" stroke-width="1" opacity=".85" />
                    </g>
                    <g id="trail-leaf-wide">
                        <path d="M0-11C10-8 13-1 8 7C4 12-2 13-7 8C-12 3-10-5 0-11Z" fill="currentColor" stroke="#2b874a" stroke-width="1.4" />
                        <path d="M-6 7C-1 3 3-2 7-7M0 2L-5 0M3-2L7 0" fill="none" stroke="#e2efca" stroke-linecap="round" stroke-width="1" opacity=".82" />
                    </g>
                    <g id="trail-blade">
