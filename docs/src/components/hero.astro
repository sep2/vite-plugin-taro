    <span class="background-mark petal petal-two" aria-hidden="true"></span>
    <span class="background-mark petal petal-three" aria-hidden="true"></span>
    <span class="background-mark dot dot-one" aria-hidden="true"></span>
    <span class="background-mark dot dot-two" aria-hidden="true"></span>

    <div class="hero-grid">
        <div class="hero-copy">
            <div class="eyebrow">— 用现代化前端工具链开发微信小程序 —</div>
            <a class="latest-version" href={latestPackageUrl} target="_blank" rel="noopener noreferrer">
                <span>最新版本</span>
                <strong>v{latestVersion}</strong>
            </a>
            <h1 id="_top" data-page-title set:html={title} />
            <div class="technology-line">
                <span>Vite 8</span><i>✿</i><span>React 19</span><i>✿</i><span>Tailwind 4</span>
            </div>
            {tagline && <div class="tagline"><span set:html={tagline} /></div>}
            {
                actions.length > 0 && (
                    <div class="actions">
                        {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
