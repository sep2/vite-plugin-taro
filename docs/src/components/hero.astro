</div>

<script>
    import confetti from 'canvas-confetti'

    const flowerShapes = [
        confetti.shapeFromPath(
            'M11 11C7 10 4 6 6 3C8 0 12 4 12 8C13 4 18 1 20 4C23 8 18 11 15 12C20 13 21 18 18 20C14 23 12 18 12 15C10 20 5 21 3 17C1 13 6 11 11 11Z'
        ),
        confetti.shapeFromPath(
            'M10 10C5 11 2 7 4 4C6 1 10 4 11 8C10 3 15 0 18 2C22 5 18 10 14 11C19 9 23 13 21 17C19 21 14 18 12 14C14 19 10 23 6 21C2 19 5 14 10 12Z'
        ),
        confetti.shapeFromPath(
            'M12 11C7 9 3 4 6 2C9 0 13 5 13 9C16 5 21 4 23 7C25 11 18 14 14 13C18 16 19 21 15 23C11 25 9 18 11 14C7 18 2 19 1 15C0 11 7 10 12 11Z'
        ),
        confetti.shapeFromPath(
            'M5 3C9 0 16 1 19 5L22 14C18 13 17 18 13 15C10 20 7 15 4 17C2 12 2 7 5 3ZM11 15L14 15L14 23L11 23Z'
        ),
        confetti.shapeFromPath(
            'M12 12C6 12 4 7 7 3C10 0 13 6 12 10C14 5 20 3 22 7C25 12 18 14 14 13C18 17 16 22 12 23C8 23 8 16 12 12Z'
        ),
        confetti.shapeFromPath(
            'M12 9C10 5 11 1 14 1C17 2 16 7 14 9C17 6 22 7 22 11C21 14 17 14 15 12C19 15 17 20 14 21C10 22 10 17 11 14C9 19 4 18 3 15C1 11 7 10 10 11C6 9 6 5 9 3C12 2 13 6 12 9Z'
        )
    ]
    const leafShape = confetti.shapeFromPath('M12 1C4 3 0 10 4 19C12 17 18 9 12 1Z')
    const grassShape = confetti.shapeFromPath(
        'M10 22C8 14 7 7 9 1C13 8 12 15 11 22ZM10 22C5 17 2 12 2 6C8 10 10 16 10 22ZM11 22C14 14 18 9 22 7C21 14 17 20 11 22Z'
    )
    const starShape = confetti.shapeFromPath({
        path: 'M5 0L6.12 3.45L9.76 3.45L6.82 5.59L7.94 9.05L5 6.91L2.06 9.05L3.18 5.59L0.24 3.45L3.88 3.45Z',
        matrix: new DOMMatrix([0.56, 0, 0, 0.56, -2.8, -2.8])
    })
    const botanicalColors = ['#e98169', '#f0b84f', '#f3a085', '#4aa95f', '#78c66d', '#b8d99e', '#3c9654', '#6fbe69']
    const botanicalShapes = [...flowerShapes, leafShape, grassShape, starShape]
    const exhaustCanvasOrigin = { x: 0.68, y: 0.34 } as const

    interface ExhaustOrigin {
        x: number
        y: number
    }

    class VptRocketStageElement extends HTMLElement {
        // This observer is retained so disconnecting the hero always stops visibility tracking.
        private observer: IntersectionObserver | null = null
        // This geometry observer refreshes the cached nozzle position only when the stage changes size.
        private geometryObserver: ResizeObserver | null = null
        // This interval exists only while the rocket is visible and is cleared as soon as it leaves the viewport.
        private emissionTimer: number | null = null
        // The cannon owns the worker-backed canvas animation and is reset when the element disconnects.
        private cannon: ReturnType<typeof confetti.create> | null = null
        // The cached origin avoids repeated layout reads for every particle emission.
        private origin: ExhaustOrigin | null = null
        // Visibility is the only mutable presentation state needed to synchronize reduced-motion changes.
        private isVisible = false
        private readonly reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

        connectedCallback(): void {
            if (this.observer !== null) return

            const flight = this.querySelector<HTMLElement>('.rocket-flight')
            const canvas = this.querySelector<HTMLCanvasElement>('.rocket-confetti')
            if (flight === null || canvas === null) return

            // Vary duration and direction without offsetting the initial resting keyframe, which prevents a startup jump.
            flight.style.animationDuration = `${17 + Math.random() * 6}s`
            flight.style.animationDirection = Math.random() < 0.5 ? 'normal' : 'reverse'
            this.cannon = confetti.create(canvas, {
                resize: true,
                useWorker: true,
                disableForReducedMotion: true
            })
            this.geometryObserver = new ResizeObserver(this.updateExhaustGeometry)
            this.geometryObserver.observe(this)
            this.updateExhaustGeometry()
            this.observer = new IntersectionObserver(
                (entries) => {
                    this.isVisible = entries.some((entry) => entry.isIntersecting)
                    this.syncRocketActivity()
                },
                { threshold: 0.25 }
            )
            this.observer.observe(this)
            this.reducedMotion.addEventListener('change', this.syncRocketActivity)
            document.addEventListener('visibilitychange', this.syncRocketActivity)
        }

        disconnectedCallback(): void {
            this.observer?.disconnect()
            this.observer = null
            this.geometryObserver?.disconnect()
            this.geometryObserver = null
            this.reducedMotion.removeEventListener('change', this.syncRocketActivity)
            document.removeEventListener('visibilitychange', this.syncRocketActivity)
            this.classList.remove('is-live')
            this.stopEmission()
            this.cannon?.reset()
            this.cannon = null
            this.origin = null
            this.isVisible = false
        }

        private readonly syncRocketActivity = (): void => {
            const isActive = this.isVisible && !document.hidden && !this.reducedMotion.matches
            if (isActive) {
                this.startEmission()
                this.classList.add('is-live')
                return
            }
            this.classList.remove('is-live')
            this.stopEmission()
        }

        private startEmission(): void {
            if (this.emissionTimer !== null) return
            this.updateExhaustGeometry()
            this.emitExhaust()
            this.emissionTimer = window.setInterval(() => this.emitExhaust(), 560)
        }

        private stopEmission(): void {
            if (this.emissionTimer === null) return
            window.clearInterval(this.emissionTimer)
            this.emissionTimer = null
        }

        private readonly updateExhaustGeometry = (): void => {
            const flight = this.querySelector<HTMLElement>('.rocket-flight')
            const originElement = this.querySelector<SVGGraphicsElement>('.rocket-confetti-origin')
            const canvas = this.querySelector<HTMLCanvasElement>('.rocket-confetti')
            if (flight === null || originElement === null || canvas === null) return

            // Measure at rest so the wrapper rotation cannot distort its local nozzle coordinates.
            const isLive = this.classList.contains('is-live')
            this.classList.remove('is-live')
            try {
                const flightBounds = flight.getBoundingClientRect()
                const originBounds = originElement.getBoundingClientRect()
                const canvasBounds = canvas.getBoundingClientRect()
                if (canvasBounds.width === 0 || canvasBounds.height === 0) return

                const nozzleX = originBounds.left + originBounds.width / 2 - flightBounds.left
                const nozzleY = originBounds.top + originBounds.height / 2 - flightBounds.top
                canvas.style.left = `${nozzleX - canvasBounds.width * exhaustCanvasOrigin.x}px`
                canvas.style.top = `${nozzleY - canvasBounds.height * exhaustCanvasOrigin.y}px`
                this.origin = exhaustCanvasOrigin
            } finally {
                this.classList.toggle('is-live', isLive)
            }
        }

        private emitExhaust(): void {
            const cannon = this.cannon
            const nozzleOrigin = this.origin
            if (cannon === null || nozzleOrigin === null) return

            const options = {
                angle: 232,
                colors: botanicalColors,
                decay: 0.9995,
                disableForReducedMotion: true,
                drift: 0,
                flat: true,
                gravity: 0.001,
                origin: nozzleOrigin,
                particleCount: 5,
                scalar: 2,
                shapes: botanicalShapes,
                spread: 68,
                startVelocity: 0.6,
                rotationSpeed: 0.03,
                tiltAmplitude: 0.8,
                tiltSpeed: 0.012,
                ticks: 480
            }
            void cannon(options)
        }
    }

    if (customElements.get('vpt-rocket-stage') === undefined) {
        customElements.define('vpt-rocket-stage', VptRocketStageElement)
    }
</script>

<style>
    @layer starlight.core {
        .hero {
            position: relative;
            isolation: isolate;
            width: 100%;
            padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 4vw, 4rem) 0;
            overflow-x: clip;
            overflow-y: visible;
            color: var(--vpt-text);
        }

        .botanical-definitions {
            position: absolute;
            width: 0;
            height: 0;
        }

        .botanical-branch,
        .background-mark {
            position: absolute;
            z-index: -1;
            pointer-events: none;
        }

        .botanical-branch {
            height: auto;
            fill: #4aa95f;
            transform-origin: center;
        }

        .botanical-top-left {
            top: -2.4rem;
            left: -0.25rem;
            width: clamp(13rem, 23vw, 21rem);
            opacity: 0.82;
            transform: rotate(-1.5deg);
        }

        .botanical-top-right {
            top: -1.7rem;
            right: -0.15rem;
            width: clamp(10rem, 18vw, 16rem);
            opacity: 0.72;
            transform: scaleX(-1) rotate(3deg);
        }

        .botanical-bottom-left {
            z-index: 1;
            bottom: -1.8rem;
            left: 0;
            width: clamp(10rem, 17vw, 15.5rem);
            opacity: 0.38;
            transform: scaleY(-1) rotate(4deg);
        }

        .botanical-bottom-right {
            z-index: 1;
            right: -0.35rem;
            bottom: -2.5rem;
            width: clamp(14rem, 24vw, 22rem);
            opacity: 0.42;
            transform: scale(-1) rotate(-3deg);
        }

        .background-mark {
            display: block;
        }

        .petal {
            width: 0.8rem;
            height: 1.35rem;
            border-radius: 70% 30% 70% 30%;
            background: #ee8a70;
            opacity: 0.78;
        }

        .petal-one {
            top: 9%;
            left: 32%;
            transform: rotate(38deg);
        }

        .petal-two {
            top: 14%;
            right: 32%;
            transform: rotate(-48deg);
        }

        .petal-three {
            right: 11%;
            bottom: 17%;
            transform: rotate(32deg);
        }

        .dot {
            width: 0.8rem;
            height: 0.8rem;
            border-radius: 50%;
            background: #64bb73;
            opacity: 0.8;
        }

        .dot-one {
            top: 7%;
            right: 24%;
        }

        .dot-two {
            bottom: 12%;
            left: 17%;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
            align-items: center;
            gap: clamp(2rem, 6vw, 6rem);
            width: min(100%, 74rem);
            margin-inline: auto;
        }

        .hero-copy {
            display: flex;
            align-items: center;
            flex-direction: column;
            text-align: center;
        }

