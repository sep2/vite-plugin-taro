                <g fill="url('#botanical-flower-gradient')" transform="translate(66 119) scale(.72)">
                    <circle cy="-8" r="6" /><circle cx="8" r="6" /><circle cy="8" r="6" /><circle cx="-8" r="6" /><circle r="4" fill="#fff1be" />
                </g>
                <circle cx="165" cy="31" r="6" fill="#ef967e" />
                <circle cx="177" cy="23" r="3.5" fill="#f4b098" />
            </g>
            <g id="botanical-sprig-berries">
