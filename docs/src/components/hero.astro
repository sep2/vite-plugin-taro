---
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import { Code, LinkButton, TabItem, Tabs } from '@astrojs/starlight/components'

const { data } = Astro.locals.starlightRoute.entry
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const { title = data.title, tagline, image, actions = [] } = data.hero ?? {}
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const rawHtml = image && 'html' in image ? image.html : undefined
---

<div class="hero">
    <div class="sl-flex stack">
        <div class="sl-flex copy">
            <h1 id="_top" data-page-title set:html={title} />
            {tagline && <div class="tagline" set:html={tagline} />}
        </div>
        {
            actions.length > 0 && (
                <div class="sl-flex actions">
                    {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
                        <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                            {text}
                            {icon?.html && <Fragment set:html={icon.html} />}
                        </LinkButton>
                    ))}
                </div>
            )
        }
        <div class="create-command">
            <Tabs syncKey="package-manager">
                <TabItem label="npm">
                    <Code code="npm create vite-taro@latest" lang="sh" />
                </TabItem>
                <TabItem label="pnpm">
                    <Code code="pnpm create vite-taro@latest" lang="sh" />
                </TabItem>
                <TabItem label="bun">
                    <Code code="bun create vite-taro" lang="sh" />
                </TabItem>
            </Tabs>
        </div>
    </div>
    {rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
</div>

<style>
    @layer starlight.core {
        .hero {
            display: grid;
            grid-template-columns: 100%;
            align-items: center;
            gap: 1rem;
            padding-bottom: 1rem;
        }

        .stack {
            flex-direction: column;
            gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
            align-items: center;
            text-align: center;
        }

        .copy {
            flex-direction: column;
            gap: 1rem;
            align-items: center;
        }

        .copy > * {
            max-width: 50ch;
        }

        h1 {
            color: var(--sl-color-white);
            font-weight: 600;
            font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
            line-height: var(--sl-line-height-headings);
        }

        .tagline {
            color: var(--sl-color-gray-2);
            font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
        }

        .actions {
            flex-wrap: wrap;
            justify-content: center;
            gap: 1rem 2rem;
        }

        .create-command {
            width: min(100%, 32rem);
            margin-top: 1rem;
            text-align: start;
        }

        .hero-html {
            object-fit: contain;
            height: auto;
            margin-inline: auto;
        }

        @media (min-width: 50rem) {
            .hero {
                padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
            }

            .stack {
                align-items: flex-start;
                text-align: start;
            }

            .copy {
                align-items: flex-start;
            }

            .actions {
                justify-content: flex-start;
            }
        }
    }

    .create-command :global(.expressive-code) {
        margin-block: 0;
    }

    @media (max-width: 49.999rem) {
        .create-command {
            display: none;
        }
    }
</style>
