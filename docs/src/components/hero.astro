                        <circle cx="-.6" cy="-.6" r=".7" fill="#d9a13e" />
                    </g>
                    <path id="trail-grass" d="M0 7C-1 1-4-3-7-7M0 7C1 0 4-4 8-8M0 7C-4 3-8 2-11 3" />
                </defs>
                <g transform="rotate(38 220 215)">
                    <g class="botanical-exhaust">
                        <use class="trail-leaf trail-leaf-light" href="#trail-leaf" transform="translate(210 304) rotate(-8) scale(.42)" />
                        <use class="trail-wisp" href="#trail-wisp" transform="translate(226 307) rotate(8) scale(.42)" />
                        <use href="#trail-flower" transform="translate(235 313) scale(.3)" />
                        <circle class="trail-seed" cx="218" cy="317" r="2.2" />

                        <use class="trail-leaf" href="#trail-leaf-wide" transform="translate(197 325) rotate(-18) scale(.7)" />
                        <use class="trail-wisp trail-wisp-gold" href="#trail-wisp" transform="translate(216 328) rotate(3) scale(.65)" />
                        <use class="trail-leaf trail-leaf-light" href="#trail-leaf" transform="translate(238 326) rotate(20) scale(.68)" />
                        <use href="#trail-flower" transform="translate(184 333) scale(.45)" />
                        <circle class="trail-seed trail-seed-coral" cx="249" cy="337" r="2.2" />

                        <use class="trail-leaf trail-leaf-pale" href="#trail-blade" transform="translate(180 348) rotate(-24) scale(.68)" />
                        <use class="trail-leaf" href="#trail-leaf" transform="translate(201 351) rotate(-10) scale(.9)" />
                        <use class="trail-leaf trail-leaf-light" href="#trail-leaf-wide" transform="translate(228 350) rotate(12) scale(.78)" />
                        <use class="trail-leaf" href="#trail-leaf" transform="translate(253 349) rotate(27) scale(.82)" />
                        <use class="trail-wisp" href="#trail-wisp" transform="translate(267 358) rotate(31) scale(.55)" />
                        <use href="#trail-flower" transform="translate(217 361) scale(.4)" />
                        <use class="trail-grass" href="#trail-grass" transform="translate(168 363) rotate(-12) scale(.55)" />

                        <use class="trail-leaf" href="#trail-leaf-wide" transform="translate(160 374) rotate(-32) scale(.62)" />
                        <use class="trail-wisp trail-wisp-gold" href="#trail-wisp" transform="translate(181 378) rotate(-20) scale(.72)" />
                        <use class="trail-leaf trail-leaf-light" href="#trail-leaf" transform="translate(204 379) rotate(-7) scale(.94)" />
                        <use class="trail-leaf" href="#trail-leaf-wide" transform="translate(232 379) rotate(10) scale(.82)" />
                        <use class="trail-wisp" href="#trail-wisp" transform="translate(256 378) rotate(22) scale(.7)" />
                        <use class="trail-leaf trail-leaf-pale" href="#trail-blade" transform="translate(279 375) rotate(36) scale(.6)" />
                        <use href="#trail-flower" transform="translate(148 387) scale(.38)" />
                        <use href="#trail-flower" transform="translate(271 391) scale(.46)" />
                        <circle class="trail-seed trail-seed-gold" cx="219" cy="393" r="2.2" />

                        <use class="trail-leaf trail-leaf-pale" href="#trail-blade" transform="translate(151 400) rotate(-35) scale(.5)" />
                        <use class="trail-leaf" href="#trail-leaf-wide" transform="translate(176 405) rotate(-22) scale(.78)" />
                        <use class="trail-wisp" href="#trail-wisp" transform="translate(198 407) rotate(-10) scale(.72)" />
                        <use class="trail-leaf trail-leaf-light" href="#trail-leaf" transform="translate(221 406) rotate(2) scale(.88)" />
                        <use class="trail-leaf" href="#trail-leaf-wide" transform="translate(247 405) rotate(17) scale(.74)" />
                        <use class="trail-wisp trail-wisp-gold" href="#trail-wisp" transform="translate(270 405) rotate(25) scale(.63)" />
                        <use class="trail-leaf" href="#trail-blade" transform="translate(291 400) rotate(39) scale(.48)" />
                        <use href="#trail-flower" transform="translate(190 418) scale(.35)" />
                        <use href="#trail-flower" transform="translate(255 418) scale(.38)" />
                        <use class="trail-grass" href="#trail-grass" transform="translate(286 419) rotate(16) scale(.46)" />

                        <use class="trail-leaf trail-leaf-pale" href="#trail-blade" transform="translate(170 428) rotate(-29) scale(.38)" />
                        <use class="trail-wisp trail-wisp-gold" href="#trail-wisp" transform="translate(197 428) rotate(-13) scale(.5)" />
                        <use class="trail-leaf trail-leaf-light" href="#trail-leaf" transform="translate(223 427) rotate(3) scale(.62)" />
                        <use class="trail-wisp" href="#trail-wisp" transform="translate(249 428) rotate(17) scale(.48)" />
                        <use class="trail-leaf" href="#trail-leaf-wide" transform="translate(275 428) rotate(31) scale(.36)" />
                        <circle class="trail-seed" cx="153" cy="420" r="2" />
                        <circle class="trail-seed trail-seed-coral" cx="300" cy="417" r="2" />

                        <use class="trail-leaf" href="#trail-leaf-wide" transform="translate(185 451) rotate(-24) scale(.48)" />
                        <use class="trail-wisp trail-wisp-gold" href="#trail-wisp" transform="translate(207 450) rotate(-11) scale(.55)" />
                        <use class="trail-leaf trail-leaf-light" href="#trail-leaf" transform="translate(231 451) rotate(7) scale(.58)" />
                        <use class="trail-wisp" href="#trail-wisp" transform="translate(254 450) rotate(19) scale(.48)" />
                        <use href="#trail-flower" transform="translate(271 447) scale(.3)" />
                        <use class="trail-leaf trail-leaf-pale" href="#trail-blade" transform="translate(201 472) rotate(-18) scale(.38)" />
                        <use class="trail-leaf" href="#trail-leaf-wide" transform="translate(223 473) rotate(2) scale(.46)" />
                        <use class="trail-leaf trail-leaf-light" href="#trail-leaf" transform="translate(246 471) rotate(20) scale(.38)" />
                        <circle class="trail-seed trail-seed-gold" cx="213" cy="486" r="1.8" />
                        <use class="trail-leaf trail-leaf-pale" href="#trail-blade" transform="translate(232 486) rotate(8) scale(.28)" />
                    </g>
                    <path class="rocket-nozzle-back" d="M188 280L252 280L249 325C231 334 209 334 191 325Z" />
                    <path class="rocket-nozzle-band" d="M190 298C210 306 230 306 250 298L249 315C230 323 210 323 190 315Z" />
