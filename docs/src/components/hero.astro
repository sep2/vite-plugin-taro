    </svg>
    <svg class="botanical-branch botanical-top-left" viewBox="-24 -24 288 190" aria-hidden="true"><use href="#botanical-sprig" /></svg>
    <svg class="botanical-branch botanical-top-right" viewBox="-24 -24 288 190" aria-hidden="true"><use href="#botanical-sprig-airy" /></svg>
    <svg class="botanical-branch botanical-bottom-left" viewBox="-24 -24 288 190" aria-hidden="true"><use href="#botanical-sprig-berries" /></svg>
    <svg class="botanical-branch botanical-bottom-right" viewBox="-24 -24 288 190" aria-hidden="true"><use href="#botanical-sprig-bloom" /></svg>
