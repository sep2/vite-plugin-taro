                        <path class="rocket-fin" d="M262 205C297 220 321 257 322 309C298 291 277 285 255 276Z" />
                        <path class="rocket-fin-detail" d="M166 229C145 246 136 267 132 289C147 280 160 274 177 269" />
                        <path class="rocket-fin-detail" d="M274 229C295 246 304 267 308 289C293 280 280 274 263 269" />
