                        <path class="rocket-panel" d="M176 281C187 300 202 311 220 311C238 311 253 300 264 281L260 251C235 261 205 261 180 251Z" />
                        <path class="rocket-panel-highlight" d="M186 271C207 280 233 280 254 271" />
                        <circle class="rocket-rivet" cx="194" cy="286" r="3" />
                        <circle class="rocket-rivet" cx="246" cy="286" r="3" />
                        <circle class="rocket-window-outer" cx="220" cy="157" r="49" />
                        <circle class="rocket-window-ring" cx="220" cy="157" r="43" />
                        <circle class="rocket-window" cx="220" cy="157" r="34" />
                        <path class="rocket-window-shine" d="M198 143C205 129 221 123 234 129" />
                        <path class="bolt" d="M227 125L201 160H218L210 189L240 150H222Z" />
                        <path class="rocket-shine" d="M205 69C185 102 177 151 181 202" />
                        <path class="rocket-shine rocket-shine-small" d="M188 217C190 230 194 241 199 250" />
