                    </g>
                    <path id="trail-wisp" d="M0-11C5-6 5 4 0 12C-5 4-4-6 0-11Z" />
                    <g id="trail-flower">
                        <path d="M0-7C4-7 5-3 3 0C7-1 9 3 6 6C3 8 1 6 0 3C-1 7-5 8-7 5C-9 2-6 0-3-1C-6-3-4-7 0-7Z" fill="#ef957a" stroke="#dc765f" stroke-width=".8" />
