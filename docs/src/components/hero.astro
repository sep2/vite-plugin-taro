---
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import { LinkButton } from '@astrojs/starlight/components'
import pluginPackage from '../../../packages/vite-plugin-taro/package.json'

const { data } = Astro.locals.starlightRoute.entry
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const { title = data.title, tagline, actions = [] } = data.hero ?? {}
const latestVersion = pluginPackage.version
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const latestPackageUrl = `https://www.npmjs.com/package/${pluginPackage.name}/v/${latestVersion}`

// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const proofPoints = [
    { icon: '↗', title: '极速启动', detail: 'Vite 8 + Rolldown' },
    { icon: '↻', title: '状态保留', detail: 'React Refresh' },
    { icon: '◇', title: '全自动分包', detail: '动态 import()' },
    { icon: '⌁', title: '现代工具链', detail: '面向未来' }
]
---

<div class="hero">
    <svg class="botanical-definitions" aria-hidden="true">
        <defs>
            <linearGradient id="botanical-leaf-gradient" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#9cd88b" />
                <stop offset=".48" stop-color="#54b86a" />
                <stop offset="1" stop-color="#27874e" />
            </linearGradient>
            <linearGradient id="botanical-flower-gradient" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#ffc0a7" />
                <stop offset="1" stop-color="#e97f6c" />
            </linearGradient>
            <g id="botanical-sprig">
                <path d="M-20 140C72 118 135 71 224-18" fill="none" stroke="#187044" stroke-linecap="round" stroke-width="5" />
                <path d="M53 118C38 78 51 52 87 49C94 84 82 108 53 118Z" fill="url('#botanical-leaf-gradient')" />
                <path d="M92 94C107 56 132 43 162 59C145 88 121 101 92 94Z" fill="url('#botanical-leaf-gradient')" />
                <path d="M126 66C116 31 133 8 165 7C169 37 155 58 126 66Z" fill="url('#botanical-leaf-gradient')" />
                <path d="M166 36C187 7 212 1 236 21C215 44 192 49 166 36Z" fill="url('#botanical-leaf-gradient')" />
                <path d="M54 114C66 89 76 69 85 53M59 101L48 91M67 84L81 80M94 91C118 78 139 67 158 61M116 79L112 68M132 71L143 76M129 62C141 43 151 25 161 10M140 45L130 39M149 31L162 34M170 34C189 29 208 25 231 22M194 28L188 18M210 25L218 31" fill="none" stroke="#d5edc3" stroke-linecap="round" stroke-width="2" opacity=".72" />
                <path d="M202 9C209-7 222-11 235-3C227 11 216 15 202 9Z" fill="url('#botanical-leaf-gradient')" />
                <g fill="url('#botanical-flower-gradient')" transform="translate(76 101) scale(1.15)">
                    <ellipse cx="0" cy="-11" rx="7" ry="13" />
                    <ellipse cx="10" cy="-2" rx="7" ry="13" transform="rotate(72 10 -2)" />
                    <ellipse cx="6" cy="10" rx="7" ry="13" transform="rotate(144 6 10)" />
                    <ellipse cx="-6" cy="10" rx="7" ry="13" transform="rotate(216 -6 10)" />
                    <ellipse cx="-10" cy="-2" rx="7" ry="13" transform="rotate(288 -10 -2)" />
                    <circle r="5" fill="#fff3cf" />
                </g>
            </g>
            <g id="botanical-sprig-airy">
                <path d="M-24 134C46 146 108 96 205-17" fill="none" stroke="#237b49" stroke-linecap="round" stroke-width="4" />
                <path d="M28 137C14 111 23 88 49 82C59 105 52 127 28 137Z" fill="url('#botanical-leaf-gradient')" />
                <path d="M68 120C74 88 94 74 120 84C109 111 91 124 68 120Z" fill="url('#botanical-leaf-gradient')" />
                <path d="M107 91C98 61 113 40 141 39C146 66 134 85 107 91Z" fill="url('#botanical-leaf-gradient')" />
