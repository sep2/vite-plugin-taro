                            <stop offset=".48" stop-color="#51b660" />
                            <stop offset="1" stop-color="#267f48" />
                        </linearGradient>
                        <linearGradient id="rocket-dark-green-gradient" x1="0" y1="0" x2="1" y2="0">
                            <stop offset="0" stop-color="#1a683d" />
                            <stop offset=".5" stop-color="#3b9853" />
                            <stop offset="1" stop-color="#145b37" />
