                <path d="M75 115C78 86 97 70 122 77C114 103 96 117 75 115Z" fill="url('#botanical-leaf-gradient')" />
                <path d="M108 91C102 65 116 47 140 47C143 71 132 87 108 91Z" fill="url('#botanical-leaf-gradient')" />
                <path d="M141 59C153 37 171 30 188 42C174 61 158 67 141 59Z" fill="url('#botanical-leaf-gradient')" />
                <path d="M44 124C47 107 49 92 50 80M77 112C91 100 105 88 118 79M111 88C120 73 130 59 138 50M144 57C159 51 172 46 185 43" fill="none" stroke="#d4ebc3" stroke-linecap="round" stroke-width="1.8" opacity=".7" />
                <circle cx="62" cy="119" r="5" fill="#ef8f78" /><circle cx="72" cy="113" r="3" fill="#f7b19b" />
                <circle cx="128" cy="72" r="4" fill="#ed927b" /><circle cx="137" cy="65" r="2.5" fill="#f7c19e" />
