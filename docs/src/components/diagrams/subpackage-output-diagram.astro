---
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import { Icon } from '@astrojs/starlight/components'

interface Props {
    headingLevel: 2 | 3
}

const { headingLevel } = Astro.props
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const Heading = headingLevel === 2 ? 'h2' : 'h3'
---

<article class="diagram-panel output-panel" data-node="flow-output" aria-labelledby="output-diagram-title">
    <header class="diagram-heading">
        <span>构建产物</span>
        <Heading id="output-diagram-title">静态依赖自动拆包</Heading>
    </header>

    <div
        class="package-stack"
        role="img"
        aria-label="启动代码保留在主包，动态入口后的静态依赖按体积拆入两个自动命名的分包"
    >
        <div class="package-card main-package">
            <div class="package-tab"><Icon name="seti:folder" /> 主包</div>
            <div class="package-content">
                <strong>启动代码</strong>
                <span>App</span><span>页面</span><span>状态 · UI</span>
            </div>
            <small>同步可达</small>
        </div>

        <div class="subpackage-grid">
            <div class="package-card">
                <div class="package-tab"><Icon name="seti:folder" /> 自动包 7f3a</div>
                <div class="package-content">
                    <span class="module-chip"><b>动态入口</b><small>0.2M</small></span>
                    <span class="module-chip"><b>图表渲染</b><small>1.5M</small></span>
                </div>
                <small>1.7M · 自动分配</small>
            </div>
            <div class="package-card">
                <div class="package-tab"><Icon name="seti:folder" /> 自动包 c921</div>
                <div class="package-content">
                    <span class="module-chip"><b>原生组件</b><small>1.3M</small></span>
                    <span class="module-chip"><b>PDF 导出</b><small>0.6M</small></span>
                </div>
                <small>1.9M · 自动分配</small>
            </div>
        </div>
    </div>

    <footer class="diagram-footer cross-package-note">
        <Icon name="random" />
        <span>主包与分包、分包与分包之间可互相调用</span>
    </footer>
</article>

<style>
    .package-stack {
        position: relative;
        margin: var(--diagram-content-gap) 0 0;
        padding-bottom: var(--diagram-footer-gap);
    }

    .package-card {
        position: relative;
        z-index: 1;
        margin: 0;
        padding: 1.4rem 1rem 1rem;
        border: 1px solid var(--vpt-border);
        border-radius: 0.35rem 1rem 1rem;
        background: var(--vpt-node-background);
        box-shadow: 0 10px 25px var(--vpt-shadow);
    }

    .main-package {
        border-color: var(--vpt-border-strong);
    }

    .package-tab {
        display: inline-flex;
        position: absolute;
        bottom: calc(100% - 0.55rem);
        left: -1px;
        align-items: center;
        gap: 0.35rem;
        margin: 0;
        padding: 0.3rem 0.65rem;
        border: 1px solid var(--vpt-border);
        border-bottom: 0;
        border-radius: 0.65rem 0.65rem 0 0;
        background: var(--vpt-node-background);
        color: var(--vpt-accent);
        font-size: var(--diagram-font-size-caption);
        font-weight: 750;
    }

    .package-tab :global(svg) {
        width: 0.85rem;
        height: 0.85rem;
    }

    .package-content {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem;
        margin: 0;
    }

    .package-content strong {
        flex-basis: 100%;
        margin-bottom: 0.2rem;
        color: var(--vpt-heading-strong);
        font-size: var(--diagram-font-size-body);
    }

    .package-content > span {
        padding: 0.25rem 0.45rem;
        border-radius: 999px;
        background: var(--vpt-chip-background);
        color: var(--vpt-chip-text);
        font-size: var(--diagram-font-size-label);
    }

    .package-content > .module-chip {
        display: inline-flex;
        min-width: 6rem;
        padding-inline: 0.6rem;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem;
        white-space: nowrap;
    }

    .module-chip b {
        font-size: var(--diagram-font-size-label);
        font-weight: 600;
    }

    .module-chip small {
        color: var(--vpt-chip-text);
        font-size: var(--diagram-font-size-caption);
    }

    .package-card > small {
        display: block;
        margin-top: 0.7rem;
        color: var(--vpt-muted);
        font-size: var(--diagram-font-size-caption);
        text-align: right;
    }

    .subpackage-grid {
        display: grid;
        position: relative;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
        margin: var(--diagram-branch-gap) 0 0;
    }

    .subpackage-grid .package-card {
        min-height: 8.5rem;
        border-color: rgba(232, 136, 112, 0.35);
    }

    .subpackage-grid .package-content {
        align-items: flex-start;
        flex-direction: column;
    }


    .cross-package-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: var(--vpt-muted);
        font-size: var(--diagram-font-size-caption);
        text-align: center;
    }

    .cross-package-note :global(svg) {
        flex: 0 0 auto;
        width: 1rem;
        color: var(--vpt-accent);
    }

    @container automatic-subpackages (max-width: 40rem) {
        .subpackage-grid {
            gap: 0.45rem;
        }

        .package-card {
            padding-inline: 0.75rem;
        }
    }
</style>
