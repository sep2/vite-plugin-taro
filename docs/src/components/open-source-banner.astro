---
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import { Icon } from '@astrojs/starlight/components'
---

<section class="open-source" aria-label="项目资源">
    <svg class="source-botanical source-botanical-left" viewBox="-24 -24 288 190" aria-hidden="true">
        <use href="#botanical-sprig-airy" />
    </svg>
    <svg class="source-botanical source-botanical-right" viewBox="-24 -24 288 190" aria-hidden="true">
        <use href="#botanical-sprig-bloom" />
    </svg>

    <div class="source-message">
        <span class="source-mark" aria-hidden="true"><Icon name="code-branch" /></span>
        <div class="source-copy">
            <p><strong>全部开源</strong><em>MIT</em><strong>协议</strong></p>
            <small>Web 开放标准，避免平台锁定，欢迎 fork 和 PR</small>
        </div>
    </div>

    <nav class="source-links" aria-label="项目链接">
        <a class="resource-link resource-link-ai" href="/llms.txt" target="_blank" rel="noopener noreferrer">
            <span class="resource-icon"><Icon name="document" /></span>
            <span class="resource-copy"><strong>llms.txt</strong></span>
        </a>
        <a
            class="resource-link"
            href="https://github.com/sep2/vite-plugin-taro"
            target="_blank"
            rel="noopener noreferrer"
        >
            <span class="resource-icon"><Icon name="github" /></span>
            <span class="resource-copy"><strong>GitHub</strong></span>
        </a>
    </nav>
</section>

<style>
    .open-source {
        display: grid;
        position: relative;
        isolation: isolate;
        grid-template-columns: minmax(0, 1fr) max-content;
        align-items: center;
        width: min(100%, var(--home-content-width));
        gap: clamp(1.5rem, 4vw, 4rem);
        margin: 0 auto;
        padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 4vw, 2.75rem);
        border: 1px solid var(--vpt-border);
        border-block-end: 0;
        border-radius: var(--home-card-radius, 1.25rem) var(--home-card-radius, 1.25rem) 0 0;
        background:
            linear-gradient(105deg, transparent, rgba(239, 150, 123, 0.08), transparent),
            var(--vpt-surface);
        overflow: hidden;
    }

    .open-source > :not(.source-botanical) {
        position: relative;
        z-index: 1;
    }

    .source-botanical {
        position: absolute;
        z-index: 0;
        bottom: -1.75rem;
        width: clamp(9rem, 16vw, 13rem);
        height: auto;
        opacity: 0.11;
        pointer-events: none;
    }

    .source-botanical-left {
        left: -1.25rem;
        transform: rotate(-8deg);
    }

    .source-botanical-right {
        right: -1.25rem;
        transform: scaleX(-1) rotate(-10deg);
    }

    .source-message {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        min-width: 0;
    }

    .source-mark {
        display: grid;
        flex: 0 0 auto;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border: 1px solid var(--vpt-border-strong);
        border-radius: 0.875rem;
        background: var(--vpt-icon-background);
        color: var(--vpt-accent-strong);
    }

    .source-mark :global(svg) {
        width: 1.15rem;
    }

    .source-copy {
        min-width: 0;
    }

    .source-copy p {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin: 0;
        color: var(--vpt-heading-strong);
        font-size: var(--home-font-size-title);
    }

    .source-copy em {
        color: #e8866e;
        font-style: normal;
        font-weight: 800;
        letter-spacing: 0.08em;
    }

    .source-copy small {
        display: block;
        margin-top: 0.25rem;
        color: var(--vpt-muted);
        font-size: var(--home-font-size-small);
        text-align: left;
    }

    .source-links {
        display: flex;
        align-items: stretch;
        gap: 0.25rem;
        padding: 0.3rem;
        border: 1px solid var(--vpt-border);
        border-radius: 1rem;
        background: color-mix(in srgb, var(--vpt-surface) 80%, var(--vpt-chip-background));
        box-shadow: 0 8px 24px var(--vpt-shadow);
    }

    .resource-link {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        min-width: 8.75rem;
        min-height: 3rem;
        padding: 0.6rem 0.8rem;
        border-radius: 0.7rem;
        color: var(--vpt-text);
        text-decoration: none;
        touch-action: manipulation;
        transition:
            background-color 180ms ease,
            transform 180ms ease;
    }

    .resource-link-ai {
        background: var(--vpt-chip-background);
    }

    .resource-link:hover {
        background: color-mix(in srgb, var(--vpt-chip-background) 72%, var(--vpt-surface));
        transform: translateY(-1px);
    }

    .resource-link:focus-visible {
        outline: 3px solid color-mix(in srgb, var(--vpt-accent) 45%, transparent);
        outline-offset: 2px;
    }

    .resource-icon {
        display: flex;
        flex: 0 0 auto;
        color: var(--vpt-accent-strong);
    }

    .resource-icon :global(svg) {
        width: 1.05rem;
    }

    .resource-copy {
        min-width: 0;
        text-align: left;
    }

    .resource-copy strong {
        color: var(--vpt-heading);
        font-size: 0.875rem;
        line-height: 1.3;
        white-space: nowrap;
    }

    .resource-link-ai .resource-copy strong {
        font-family: var(--__sl-font-mono);
    }

    @media (max-width: 50rem) {
        .open-source {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }

        .source-message {
            justify-content: center;
            text-align: center;
        }

        .source-copy p {
            justify-content: center;
            flex-wrap: wrap;
        }

        .source-links {
            width: min(100%, 23rem);
            margin-inline: auto;
        }

        .resource-link {
            flex: 1;
            justify-content: center;
            min-width: 0;
        }
    }

    @media (max-width: 40rem) {
        .source-botanical {
            width: 8rem;
            opacity: 0.09;
        }

        .source-copy small {
            line-height: 1.5;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .resource-link {
            transition: none;
        }
    }
</style>
