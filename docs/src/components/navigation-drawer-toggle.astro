---
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import { Icon } from '@astrojs/starlight/components'
---

<button
    type="button"
    popovertarget="starlight__sidebar"
    aria-label={Astro.locals.t('menuButton.accessibleLabel')}
    class="print:hidden"
>
    <Icon name="bars" class="open-menu" />
    <Icon name="close" class="close-menu" />
</button>

<style>
    @layer starlight.core {
        button {
            display: flex;
            position: fixed;
            z-index: var(--sl-z-index-navbar);
            top: calc((var(--sl-nav-height) - var(--sl-menu-button-size) - 1px) / 2);
            inset-inline-end: var(--sl-nav-pad-x);
            align-items: center;
            justify-content: center;
            width: var(--sl-menu-button-size);
            height: var(--sl-menu-button-size);
            padding: 0.5rem;
            border: 0;
            border-radius: 50%;
            background-color: var(--sl-color-white);
            box-shadow: var(--sl-shadow-md);
            color: var(--sl-color-black);
            cursor: pointer;
        }

        button:has(~ :popover-open) {
            background-color: var(--sl-color-gray-2);
            box-shadow: none;
        }

        button:has(~ :popover-open) .open-menu,
        button:not(:has(~ :popover-open)) .close-menu {
            display: none;
        }

        :global([data-theme='light']) button {
            background-color: var(--sl-color-black);
            color: var(--sl-color-white);
        }

        :global([data-theme='light']) button:has(~ :popover-open) {
            background-color: var(--sl-color-gray-5);
        }
    }
</style>
