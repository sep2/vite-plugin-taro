---
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import AppViewShowcase from './app-view-showcase.astro'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import AutomaticSubpackagesShowcase from './automatic-subpackages-showcase.astro'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import HmrShowcase from './hmr-showcase.astro'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import HomeFeatures from './home-features.astro'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import NativeComponentsShowcase from './native-components-showcase.astro'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import OpenSourceBanner from './open-source-banner.astro'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import TailwindShowcase from './tailwind-showcase.astro'
---

<div class="home-content-rail">
    <AppViewShowcase />
    <HmrShowcase />
    <AutomaticSubpackagesShowcase />
    <TailwindShowcase />
    <NativeComponentsShowcase />
    <HomeFeatures />
    <OpenSourceBanner />
</div>

<style>
    .home-content-rail {
        padding-inline: var(--home-page-gutter);
    }
</style>
