---
import { fetchLatestStableVersion } from '../lib/fetch-latest-stable-version.ts'

interface Props {
    packageName: string
}

const { packageName } = Astro.props
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const latestVersion = await fetchLatestStableVersion(packageName)
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const packageUrl = `https://www.npmjs.com/package/${packageName}`
---

<a
    class="latest-version"
    href={packageUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`在 npm 查看 ${packageName} 最新版本`}
>
    <span>最新版本</span>
    <strong>v{latestVersion}</strong>
</a>

<style>
    @layer starlight.core {
        .latest-version {
            display: inline-flex;
            position: relative;
            z-index: 1;
            align-items: center;
            gap: 0.45rem;
            margin-bottom: 2rem;
            padding: 0.32rem 0.7rem;
            border: 1px solid var(--vpt-border);
            border-radius: 999px;
            background: var(--vpt-surface);
            color: var(--vpt-muted);
            font-size: var(--home-font-size-small);
            line-height: 1;
            text-decoration: none;
        }

        .latest-version strong {
            color: var(--vpt-accent-strong);
        }
    }
</style>
