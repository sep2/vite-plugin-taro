---
import './floating-content.css'
import '../styles/vpt-theme.css'

// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import { Icon } from '@astrojs/starlight/components'

interface Props {
    id: string
    label: string
    description: string
    collapseLabel: string
    collapseText: string
    expandLabel: string
    inlineSize: string
    blockSize: string
}

// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const { id, label, description, collapseLabel, collapseText, expandLabel, inlineSize, blockSize } = Astro.props
// biome-ignore lint/correctness/noUnusedVariables: Rendered by the Astro template.
const noScriptStyles = `
<style>
    @media (min-width: 84rem) {
        .floating-content:not([data-collapsed]) {
            block-size: auto;
        }

        .floating-content:not([data-collapsed]) > .floating-content-layer {
            position: static;
            top: auto;
            left: auto;
            z-index: auto;
            width: auto;
            pointer-events: auto;
            transform: none;
        }

        .floating-content:not([data-collapsed]) > .floating-content-layer .floating-content-viewport {
            padding: var(--floating-content-padding) 0;
        }

        .floating-content:not([data-collapsed]) > .floating-content-layer .floating-content-inner {
            width: auto;
            margin: 0;
        }

        .floating-content:not([data-collapsed]) > .floating-content-layer .floating-content-collapse {
            display: none;
        }
    }
</style>
`
---

<vpt-floating-content
    class="floating-content not-content vpt-theme"
    style={`--floating-content-block-size: ${blockSize}`}
    role="region"
    aria-label={label}
    aria-owns={id}
>
    <div
        class="floating-content-layer vpt-theme"
        style={`--floating-content-inline-size: ${inlineSize}`}
        data-floating-content-layer
    >
        <div id={id} class="floating-content-viewport" tabindex="-1">
            <div class="floating-content-inner">
                <slot />
            </div>
        </div>

        <button
            class="floating-content-collapse"
            type="button"
            aria-label={collapseLabel}
            aria-controls={id}
            aria-expanded="true"
            data-floating-content-collapse
        >
            <span>{collapseText}</span>
            <Icon name="up-caret" />
        </button>
    </div>

    <button
        class="floating-content-placeholder"
        type="button"
        aria-label={expandLabel}
        aria-controls={id}
        aria-expanded="false"
        data-floating-content-expand
    >
        <span class="placeholder-icon"><Icon name="code-branch" /></span>
        <span class="placeholder-copy">
            <strong>{label}</strong>
            <small>{description}</small>
        </span>
        <span class="placeholder-action">
            展开 <Icon name="right-arrow" />
        </span>
    </button>
</vpt-floating-content>

<script is:inline data-astro-rerun>
    if (customElements.get('vpt-floating-content') === undefined) {
        class VptFloatingContent extends HTMLElement {
            // These mutable references own the layer's responsive placement and event lifecycle.
            #layer
            #wideLayout
            #events
            #onResize = () => {
                this.updateLayout()
                this.updatePosition()
            }

            initialize() {
                this.#layer = this.querySelector('[data-floating-content-layer]')
                this.#wideLayout = matchMedia('(min-width: 84rem)')
                this.#events = new AbortController()

                this.#layer.addEventListener(
                    'click',
                    (event) => {
                        const target = event.target
                        if (!(target instanceof Element)) return
                        if (target.closest('[data-floating-content-collapse]') === null) return
                        this.setCollapsed(true)
                        this.querySelector('[data-floating-content-expand]').focus()
                    },
                    { signal: this.#events.signal }
                )
                this.querySelector('[data-floating-content-expand]').addEventListener(
                    'click',
                    () => {
                        this.setCollapsed(false)
                        this.#layer.querySelector('.floating-content-viewport').focus({ preventScroll: true })
                    },
                    { signal: this.#events.signal }
                )
                window.addEventListener('resize', this.#onResize, { signal: this.#events.signal })
                this.updateLayout()
                this.updatePosition()
            }

            disconnectedCallback() {
                this.#events?.abort()
                if (this.#layer?.hasAttribute('data-floating-content-floating')) this.#layer.remove()
            }

            updateLayout() {
                const shouldFloat = this.#wideLayout.matches && !this.hasAttribute('data-collapsed')
                if (shouldFloat) {
                    if (this.#layer.hasAttribute('data-floating-content-floating')) return
                    this.#layer.setAttribute('data-floating-content-floating', '')
                    document.body.append(this.#layer)
                    return
                }
                if (!this.#layer.hasAttribute('data-floating-content-floating')) return
                this.#layer.removeAttribute('data-floating-content-floating')
                this.#layer.style.removeProperty('top')
                this.prepend(this.#layer)
            }

            updatePosition() {
                if (!this.#layer.hasAttribute('data-floating-content-floating')) return
                const anchorTop = this.getBoundingClientRect().top + window.scrollY
                this.#layer.style.top = `${anchorTop}px`
            }

            setCollapsed(collapsed) {
                this.toggleAttribute('data-collapsed', collapsed)
                this.#layer.hidden = collapsed
                this.#layer.querySelector('[data-floating-content-collapse]').ariaExpanded = String(!collapsed)
                this.querySelector('[data-floating-content-expand]').ariaExpanded = String(!collapsed)
                this.updateLayout()
                this.updatePosition()
            }
        }

        customElements.define('vpt-floating-content', VptFloatingContent)
    }

    document.currentScript.previousElementSibling.initialize()
</script>

<noscript set:html={noScriptStyles} />
