---
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import Sidebar from 'virtual:starlight/components/Sidebar'
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import NavigationDrawerToggle from './navigation-drawer-toggle.astro'
---

<div class="page sl-flex">
    <header class="header"><slot name="header" /></header>
    <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
        <NavigationDrawerToggle />
        <vpt-navigation-drawer popover="auto" id="starlight__sidebar" class="sidebar-pane">
            <div class="sidebar-content sl-flex">
                <Sidebar />
            </div>
        </vpt-navigation-drawer>
    </nav>
    <div class="main-frame"><slot /></div>
</div>

<script>
    // The browser owns opening, dismissal, and focus restoration, even without JavaScript.
    // Enhance the native popover by keeping keyboard focus out of the covered page content.
    class VptNavigationDrawer extends HTMLElement {
        constructor() {
            super()
            this.addEventListener('toggle', ({ newState }) => this.trapFocus(newState === 'open'))
        }

        disconnectedCallback(): void {
            this.trapFocus(false)
        }

        private trapFocus(expanded: boolean): void {
            document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link').forEach((element) => {
                element.toggleAttribute('inert', expanded)
            })
        }
    }

    customElements.define('vpt-navigation-drawer', VptNavigationDrawer)
</script>

<style>
    @layer starlight.core {
        .page {
            flex-direction: column;
            min-height: 100vh;
        }

        .header {
            z-index: var(--sl-z-index-navbar);
            position: fixed;
            inset-inline-start: 0;
            inset-block-start: 0;
            width: 100%;
            height: var(--sl-nav-height);
            border-bottom: 1px solid var(--sl-color-hairline-shade);
            padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
            padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
            background-color: var(--sl-color-bg-nav);
        }

        .sidebar-pane {
            /* Reset the user-agent popover box without overriding its native display state. */
            margin: 0;
            border: 0;
            padding: 0;
            height: auto;
            color: inherit;
            position: fixed;
            inset-block: var(--sl-nav-height) 0;
            inset-inline: 0;
            width: 100%;
            background-color: var(--sl-color-black);
            overflow-y: auto;
            scrollbar-gutter: stable;
        }

        .sidebar-content {
            height: 100%;
            min-height: max-content;
            padding: 1rem var(--sl-sidebar-pad-x) 0;
            flex-direction: column;
            gap: 1rem;
        }

        .main-frame {
            padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
            padding-inline-start: var(--sl-content-inline-start);
        }

        @media (min-width: 50rem) {
            .sidebar-content::after {
                content: '';
                padding-bottom: 1px;
            }

            .sidebar-pane {
                inset-inline: auto 0;
                width: min(24rem, 100%);
                border-inline-start: 1px solid var(--sl-color-hairline-shade);
                background-color: var(--sl-color-bg-sidebar);
                box-shadow: var(--sl-shadow-lg);
            }
        }
    }
</style>

<style is:global>
    @layer starlight.utils {
        /* Derive scroll locking from native state so it also works before scripts load. */
        body:has(vpt-navigation-drawer:popover-open) {
            overflow: hidden;
        }
    }
</style>
