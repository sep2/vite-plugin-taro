---
// biome-ignore lint/correctness/noUnusedImports: Rendered by the Astro template.
import { Icon } from '@astrojs/starlight/components'
---

<theme-toggle>
    <div class="theme-options" role="group" aria-label="颜色主题">
        <button
            class="theme-option"
            type="button"
            data-theme-value="auto"
            aria-label="跟随系统主题"
            aria-pressed="true"
            title="跟随系统主题"
        >
            <Icon name="laptop" />
        </button>
        <button
            class="theme-option"
            type="button"
            data-theme-value="light"
            aria-label="浅色主题"
            aria-pressed="false"
            title="浅色主题"
        >
            <Icon name="sun" />
        </button>
        <button
            class="theme-option"
            type="button"
            data-theme-value="dark"
            aria-label="深色主题"
            aria-pressed="false"
            title="深色主题"
        >
            <Icon name="moon" />
        </button>
    </div>
    <button
        class="theme-toggle-button"
        type="button"
        aria-label="深色主题"
        aria-pressed="false"
        title="切换颜色主题"
    >
        <span class="light-theme-icon"><Icon name="sun" /></span>
        <span class="dark-theme-icon"><Icon name="moon" /></span>
    </button>
</theme-toggle>

<script>
    type Theme = 'auto' | 'dark' | 'light'

    const storageKey = 'starlight-theme'
    const colorScheme = matchMedia('(prefers-color-scheme: light)')

    function parseTheme(value: string | null | undefined): Theme {
        return value === 'dark' || value === 'light' ? value : 'auto'
    }

    function loadTheme(): Theme {
        return parseTheme(localStorage.getItem(storageKey))
    }

    function resolveTheme(theme: Theme): Exclude<Theme, 'auto'> {
        return theme === 'auto' ? (colorScheme.matches ? 'light' : 'dark') : theme
    }

    function updateControls(theme: Theme): void {
        const resolvedTheme = resolveTheme(theme)

        document.querySelectorAll<HTMLButtonElement>('theme-toggle [data-theme-value]').forEach((button) => {
            button.ariaPressed = String(button.dataset.themeValue === theme)
        })
        document.querySelectorAll<HTMLButtonElement>('theme-toggle .theme-toggle-button').forEach((button) => {
            button.ariaPressed = String(resolvedTheme === 'dark')
        })
    }

    function applyTheme(theme: Theme): void {
        document.documentElement.dataset.theme = resolveTheme(theme)
        localStorage.setItem(storageKey, theme === 'auto' ? '' : theme)
        updateControls(theme)
    }

    class ThemeToggle extends HTMLElement {
        constructor() {
            super()
            this.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((button) => {
                button.addEventListener('click', () => applyTheme(parseTheme(button.dataset.themeValue)))
            })
            this.querySelector<HTMLButtonElement>('.theme-toggle-button')?.addEventListener('click', () => {
                applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark')
            })
        }
    }

    colorScheme.addEventListener('change', () => {
        if (loadTheme() === 'auto') applyTheme('auto')
    })

    if (!customElements.get('theme-toggle')) customElements.define('theme-toggle', ThemeToggle)
    applyTheme(loadTheme())
</script>

<style>
    theme-toggle {
        align-self: center;
        display: flex;
    }

    .theme-options {
        display: flex;
        gap: 0.125rem;
        padding: 0.125rem;
        border: 1px solid var(--sl-color-hairline-light);
        border-radius: 0.5rem;
    }

    button {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--sl-color-gray-2);
        font-size: 1rem;
        cursor: pointer;
        transition:
            background-color 160ms ease,
            color 160ms ease;
    }

    button:hover {
        color: var(--sl-color-white);
    }

    button:focus-visible {
        outline: 2px solid var(--sl-color-accent-high);
        outline-offset: -2px;
    }

    .theme-option {
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 0.375rem;
    }

    .theme-option[aria-pressed='true'] {
        background: var(--sl-color-accent-low);
        color: var(--sl-color-text-accent);
        animation: select-theme 180ms ease-out;
    }

    .theme-toggle-button {
        display: none;
        width: var(--sl-menu-button-size);
        height: var(--sl-menu-button-size);
        border-radius: 50%;
    }

    .theme-toggle-button > span {
        display: flex;
        line-height: 0;
    }

    .theme-toggle-button:hover {
        background: var(--sl-color-accent-low);
        color: var(--sl-color-text-accent);
    }

    .theme-toggle-button > .dark-theme-icon {
        display: none;
    }

    :global(:root[data-theme='dark']) .theme-toggle-button > .light-theme-icon {
        display: none;
    }

    :global(:root[data-theme='dark']) .theme-toggle-button > .dark-theme-icon {
        display: flex;
    }

    @keyframes select-theme {
        from {
            transform: scale(0.85);
        }
    }

    @media (max-width: 49.999rem) {
        .theme-options {
            display: none;
        }

        .theme-toggle-button {
            display: flex;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        button {
            transition: none;
            animation: none;
        }
    }
</style>
