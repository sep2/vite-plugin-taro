+/** Host-owned creation, form classification and post-commit work for the shared React renderer. */
+export type RendererHost<Container, Context, Element, Text> = Readonly<{
+    createElement(container: Container, context: Context, type: string): Element
+    createText(container: Container, context: Context, text: string): Text
+    isFormElement(element: Element): boolean
+    afterCommit(container: Container): void
+}>
