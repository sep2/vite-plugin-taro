+    /*
+     * The App scheduler hydrates this host tree into Page.data.app, but outlet.childNodes are the live Taro Page roots kept
+     * there to preserve one React/App ancestry. Traversing them would copy every mounted Page into every native Page's App
+     * mirror, cross the app/page scheduler boundary, and make Page changes invalidate App data. Serialize the outlet as an
+     * empty marker instead. Generated Page WXML fills that exact position from Page.data.page through its slot, while the
+     * in-memory Page roots remain untouched for lifecycle, event, and removal ownership.
+     */
+    data["cn" /* Shortcuts.Childnodes */] = nodeName === 'vpt_page_outlet'
