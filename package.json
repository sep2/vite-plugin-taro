{
    "name": "vite-plugin-taro-monorepo",
    "private": true,
    "author": "sep2",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sep2/vite-plugin-taro.git"
    },
    "bugs": {
        "url": "https://github.com/sep2/vite-plugin-taro/issues"
    },
    "homepage": "https://vpt.js.org",
    "scripts": {
        "prepare:taro": "pnpm --filter vite-plugin-taro-runtime build",
        "build:plugin": "pnpm --filter vite-plugin-taro build",
        "build:native-comp-demo:wx": "pnpm --filter native-comp-demo build-wx",
        "build:native-comp-demo:zfb": "pnpm --filter native-comp-demo build-zfb",
        "dev:native-comp-demo:wx": "pnpm --filter native-comp-demo dev-wx",
        "dev:native-comp-demo:zfb": "pnpm --filter native-comp-demo dev-zfb",
        "build:hmr-stress-demo:wx": "pnpm --filter hmr-stress-demo build-wx",
        "build:hmr-stress-demo:zfb": "pnpm --filter hmr-stress-demo build-zfb",
        "dev:hmr-stress-demo:wx": "pnpm --filter hmr-stress-demo dev-wx",
        "dev:hmr-stress-demo:zfb": "pnpm --filter hmr-stress-demo dev-zfb",
        "stress:hmr-stress-demo": "pnpm --filter hmr-stress-demo stress-hmr",
        "stress:hmr-stress-demo:burst": "pnpm --filter hmr-stress-demo stress-hmr:burst",
        "setup:hmr-stress-demo:devtools": "pnpm --filter hmr-stress-demo setup-devtools",
        "test:hmr-stress-demo:devtools": "pnpm --filter hmr-stress-demo test-devtools",
        "test:hmr-stress-demo:interpreter": "pnpm --filter hmr-stress-demo test-interpreter",
        "test:hmr-stress-demo:rebuild": "pnpm --filter hmr-stress-demo test-devtools:rebuild",
        "test:hmr-stress-demo:recovery": "pnpm --filter hmr-stress-demo test-devtools:recovery",
        "build:towxml-stream-demo:wx": "pnpm --filter towxml-stream-demo build-wx",
        "dev:towxml-stream-demo:wx": "pnpm --filter towxml-stream-demo dev-wx",
        "build:loan-genius:h5": "pnpm --filter loan-genius build-h5",
        "build:loan-genius:wx": "pnpm --filter loan-genius build-wx",
        "build:loan-genius:zfb": "pnpm --filter loan-genius build-zfb",
        "dev:loan-genius:h5": "pnpm --filter loan-genius dev-h5",
        "dev:loan-genius:wx": "pnpm --filter loan-genius dev-wx",
        "dev:loan-genius:zfb": "pnpm --filter loan-genius dev-zfb",
        "test:loan-genius:hmr": "pnpm --filter loan-genius test-hmr-wx",
        "preview:loan-genius:h5": "pnpm --filter loan-genius preview-h5",
        "dev:docs": "pnpm --filter docs dev",
        "typecheck": "pnpm typecheck:scripts && pnpm --recursive --if-present typecheck",
        "typecheck:scripts": "tsc --project scripts/tsconfig.json --noEmit",
        "typecheck:plugin": "pnpm --filter vite-plugin-taro typecheck",
        "typecheck:native-comp-demo": "pnpm --filter native-comp-demo typecheck",
        "typecheck:hmr-stress-demo": "pnpm --filter hmr-stress-demo typecheck",
        "typecheck:towxml-stream-demo": "pnpm --filter towxml-stream-demo typecheck",
        "typecheck:loan-genius": "pnpm --filter loan-genius typecheck",
        "test": "pnpm test:release && pnpm --filter vite-plugin-taro test",
        "test:release": "node --test scripts/*.test.ts",
        "test:coverage": "pnpm --filter vite-plugin-taro test:coverage",
        "lint": "biome check .",
        "format": "biome check --write .",
        "changeset": "changeset",
        "release": "changeset version && pnpm install --lockfile-only && biome format --write .changeset"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@changesets/cli": "^3.0.2",
        "@types/node": "^26.5.1",
        "typescript": "^7.0.2"
    },
    "packageManager": "pnpm@11.24.0"
}
