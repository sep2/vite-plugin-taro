{
    "name": "vite-plugin-taro",
    "version": "0.8.5",
    "author": "sep2",
    "description": "Vite 8 plugin for building one React/Taro codebase for WeChat, Alipay, Taobao, TikTok, and H5 targets.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sep2/vite-plugin-taro.git",
        "directory": "packages/vite-plugin-taro"
    },
    "bugs": {
        "url": "https://github.com/sep2/vite-plugin-taro/issues"
    },
    "homepage": "https://vpt.js.org",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./client": {
            "types": "./client.d.ts"
        },
        "./types/native": {
            "types": "./src/runtime/client/taro/native.ts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "client.d.ts",
        "LICENSE",
        "README.md",
        "README.en.md"
    ],
    "scripts": {
        "build": "node ../../scripts/sync-plugin-readme.ts && node ./scripts/build.ts",
        "test": "node --experimental-vfs --test --test-concurrency=4 --test-reporter=dot \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
        "test:coverage": "c8 node --experimental-vfs --test --test-concurrency=4 \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
        "typecheck": "tsc --project tsconfig.json --noEmit"
    },
    "keywords": [
        "vpt",
        "vite",
        "vite-plugin",
        "taro",
        "wechat",
        "alipay",
        "taobao",
        "tiktok",
        "mini-program",
        "react"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "module": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./client": {
                "types": "./client.d.ts"
            },
            "./types/native": {
                "types": "./dist/runtime/client/taro/native.d.ts"
            },
            "./package.json": "./package.json"
        }
    },
    "engines": {
        "node": "^22.18.0 || >=24.11.0"
    },
    "dependencies": {
        "@tailwindcss/node": "4.3.4",
        "@tailwindcss/oxide": "4.3.4",
        "@tailwindcss/vite": "4.3.4",
        "@tarojs/shared": "4.3.2",
        "@vitejs/plugin-react": "^6.2.1",
        "core-js": "^3.51.0",
        "lightningcss": "1.33.0",
        "react-reconciler": "0.34.0",
        "rolldown": "1.2.16",
        "sval": "0.6.12",
        "tailwindcss": "^4.3.4",
        "vite-plugin-taro-runtime": "workspace:*"
    },
    "peerDependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "vite": "8.3.6"
    },
    "devDependencies": {
        "@babel/core": "^8.1.0",
        "@babel/generator": "^8.1.0",
        "@babel/plugin-transform-dynamic-import": "^8.0.1",
        "@babel/plugin-transform-modules-commonjs": "^8.0.1",
        "@babel/plugin-transform-modules-systemjs": "^8.1.0",
        "@oxc-project/types": "0.157.0",
        "@tailwindcss-mangle/engine": "0.2.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-refresh": "^0.14.7",
        "@weapp-core/escape": "8.0.0",
        "@weapp-tailwindcss/postcss": "3.4.3",
        "c8": "^12.0.0",
        "oxc-walker": "1.1.1",
        "picocolors": "^1.1.1",
        "postcss-rule-unit-converter": "0.3.0",
        "rxjs": "^7.8.2",
        "typescript": "^7.0.2",
        "vite": "8.3.6"
    }
}
