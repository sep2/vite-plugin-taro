{
    "name": "vite-plugin-taro",
    "version": "0.6.20-beta.1",
    "author": "sep2",
    "description": "Vite 8 plugin for building one React/Taro codebase for WeChat Mini Program and H5 targets.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sep2/vite-plugin-taro.git",
        "directory": "packages/vite-plugin-taro"
    },
    "bugs": {
        "url": "https://github.com/sep2/vite-plugin-taro/issues"
    },
    "homepage": "https://vpt.js.org",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./client": {
            "types": "./client.d.ts"
        },
        "./types/native": {
            "types": "./src/runtime/client/taro/native.ts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "client.d.ts",
        "LICENSE",
        "README.md",
        "README.en.md"
    ],
    "scripts": {
        "build": "node ../../scripts/sync-plugin-readme.ts && node ./scripts/build.ts",
        "test": "node --test --test-concurrency=2",
        "test:coverage": "c8 node --test --test-concurrency=2",
        "typecheck": "tsc --project tsconfig.json --noEmit"
    },
    "keywords": [
        "vite",
        "vite-plugin",
        "taro",
        "wechat",
        "mini-program",
        "react"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "module": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./client": {
                "types": "./client.d.ts"
            },
            "./types/native": {
                "types": "./dist/runtime/client/taro/native.d.ts"
            },
            "./package.json": "./package.json"
        }
    },
    "engines": {
        "node": "^22.18.0 || >=24.11.0"
    },
    "dependencies": {
        "@tailwindcss/node": "4.3.3",
        "@tailwindcss/oxide": "4.3.3",
        "@tailwindcss/vite": "4.3.3",
        "@tarojs/components": "4.2.1",
        "@tarojs/helper": "4.2.1",
        "@tarojs/plugin-framework-react": "workspace:vite-plugin-taro-plugin-framework-react@*",
        "@tarojs/plugin-platform-h5": "4.2.1",
        "@tarojs/plugin-platform-weapp": "4.2.1",
        "@tarojs/react": "workspace:vite-plugin-taro-react@*",
        "@tarojs/router": "4.2.1",
        "@tarojs/runtime": "workspace:vite-plugin-taro-runtime@*",
        "@tarojs/taro": "4.2.1",
        "@vitejs/plugin-react": "^6.1.0",
        "react-reconciler": "0.33.0",
        "rolldown": "1.2.5",
        "tailwindcss": "^4.3.3"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "vite": "8.2.2"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/generator": "^8.0.0",
        "@babel/plugin-transform-dynamic-import": "^8.0.1",
        "@babel/plugin-transform-modules-commonjs": "^8.0.1",
        "@babel/plugin-transform-modules-systemjs": "^8.0.1",
        "@babel/types": "^8.0.4",
        "@oxc-project/types": "0.147.0",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss-mangle/engine": "0.2.0",
        "@types/node": "^26.3.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@types/react-refresh": "^0.14.7",
        "@weapp-core/escape": "8.0.0",
        "@weapp-tailwindcss/postcss": "3.2.11",
        "c8": "^12.0.0",
        "oxc-walker": "1.1.1",
        "picocolors": "^1.1.1",
        "rxjs": "^7.8.2",
        "typescript": "^7.0.2",
        "vite": "8.2.2"
    }
}
