{
    "name": "vite-taro-app",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev:wx": "cross-env VITE_VPT_TARGET=wx vite",
        "dev:zfb": "cross-env VITE_VPT_TARGET=zfb vite",
        "dev:tt": "cross-env VITE_VPT_TARGET=tt vite",
        "dev:h5": "cross-env VITE_VPT_TARGET=h5 vite",
        "build:wx": "cross-env VITE_VPT_TARGET=wx vite build",
        "build:zfb": "cross-env VITE_VPT_TARGET=zfb vite build",
        "build:tt": "cross-env VITE_VPT_TARGET=tt vite build",
        "build:h5": "cross-env VITE_VPT_TARGET=h5 vite build",
        "preview:h5": "cross-env VITE_VPT_TARGET=h5 vite preview --outDir dist/h5",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "typescript": "^7.0.2",
        "cross-env": "^10.1.0",
        "rolldown": "1.2.13",
        "vite": "8.3.4"
    },
    "overrides": {
        "@types/react": "$@types/react",
        "rolldown": "$rolldown"
    }
}
