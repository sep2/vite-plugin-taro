{
    "name": "hmr-stress-demo",
    "version": "0.5.6",
    "private": true,
    "author": "sep2",
    "type": "module",
    "scripts": {
        "build-wx": "cross-env NODE_ENV=production VITE_VPT_TARGET=wx vite build",
        "build-zfb": "cross-env NODE_ENV=production VITE_VPT_TARGET=zfb vite build",
        "dev-wx": "cross-env NODE_ENV=development VITE_VPT_TARGET=wx vite",
        "dev-zfb": "cross-env NODE_ENV=development VITE_VPT_TARGET=zfb vite",
        "stress-hmr": "node scripts/run-devtools-tests.ts burst",
        "stress-hmr:burst": "node scripts/run-devtools-tests.ts burst",
        "setup-devtools": "cross-env VPT_HMR_SETUP=1 node scripts/run-devtools-tests.ts setup",
        "test-devtools": "node scripts/run-devtools-tests.ts all",
        "test-interpreter": "cross-env VPT_HMR_MODE=interpreter node scripts/run-devtools-tests.ts all",
        "test-devtools:burst": "node scripts/run-devtools-tests.ts burst",
        "test-devtools:cold-page": "node scripts/run-devtools-tests.ts cold-page",
        "test-devtools:rebuild": "node scripts/run-devtools-tests.ts rebuild",
        "test-devtools:recovery": "node scripts/run-devtools-tests.ts recovery",
        "test-devtools:restart": "cross-env VPT_HMR_RESTART_BUILD_DELAY_MS=3000 node scripts/run-devtools-tests.ts restart",
        "test-devtools:port-swap": "cross-env VPT_HMR_RESTART_BUILD_DELAY_MS=3000 node scripts/run-port-swap-devtools-test.ts port-swap",
        "test-build-watch:restart": "cross-env VPT_HMR_RESTART_BUILD_DELAY_MS=3000 node scripts/run-build-watch-devtools-test.ts",
        "typecheck": "tsc --project tsconfig.json"
    },
    "dependencies": {
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "vite-plugin-taro": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "cross-env": "^10.1.0",
        "typescript": "^7.0.2",
        "vite": "8.3.0"
    }
}
